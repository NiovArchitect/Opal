html.opal-native-host .fr-splash-wordmark {
  top: calc(338px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-mechanic,
html.opal-native-host .fr-splash-tagline {
  top: calc(408px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-skip {
  top: calc(64px + env(safe-area-inset-top, 0px)) !important;
  bottom: auto !important;
  right: 24px !important;
  left: auto !important;
}
html.opal-native-host .fr-splash-tap {
  top: auto !important;
  bottom: calc(100px + env(safe-area-inset-bottom, 0px)) !important;
}
html.opal-native-host .fr-splash-returning {
  top: auto !important;
  bottom: calc(40px + env(safe-area-inset-bottom, 0px)) !important;
}

/* Promise — native host: clip art so Enter Opal + Sign in stay fully visible. */
html.opal-native-host .first-run-promise-page {
  height: 100dvh !important;
  min-height: 100dvh !important;
  max-height: 100dvh !important;
  padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px)) !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
}
html.opal-native-host .first-run-promise-clip {
  max-height: calc(100dvh - 140px) !important;
  width: min(390px, 100%, calc((100dvh - 140px) * 941 / 1490)) !important;
  flex: 0 1 auto !important;
}
html.opal-native-host .first-run-promise-img {
  width: 100% !important;
  margin: 0 !important;
  height: auto !important;
}
html.opal-native-host .first-run-promise-status-crop {
  height: 40px !important;
}
html.opal-native-host .first-run-promise-cta {
  position: relative !important;
  top: auto !important;
  bottom: auto !important;
  left: auto !important;
  margin: 12px auto calc(8px + env(safe-area-inset-bottom, 0px)) !important;
  flex-shrink: 0 !important;
}

/*
 * Fluid phone first-run / auth (browser + native).
 * Extends native-host bottom-anchor + safe-area to all phone widths ≤519.
 * Do not pad the stage with safe-area AND bottom-anchor CTAs (double-count = 0).
 */
@media (max-width: 519px) {
  .fr-auth-header {
    top: calc(18px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-title {
    top: calc(112px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-body {
    top: calc(194px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4.fr-verify .fr-body,
  .fr-auth-v4.fr-profile .fr-body,
  .fr-auth-v4.fr-find .fr-body {
    top: calc(164px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-status,
  .fr-auth-v4 .fr-error {
    top: calc(230px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4.fr-phone label[for=\"fr-phone\"] {
    top: calc(248px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-phone-field {
    top: calc(270px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-phone-hint {
    top: calc(354px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-consent {
    top: calc(400px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-code-wrap {
    top: calc(250px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4.fr-phone .fr-primary,
  .fr-auth-v4.fr-phone .btn.primary.fr-primary,
  .fr-auth-v4.fr-verify .fr-primary,
  .fr-auth-v4.fr-verify .btn.primary.fr-primary {
    top: auto;
    bottom: calc(66px + env(safe-area-inset-bottom, 0px));
  }
  .fr-auth-v4.fr-phone .fr-text-action,
  .fr-auth-v4.fr-phone .fr-skip-for-now,
  .fr-auth-v4.fr-verify .fr-text-action,
  .fr-auth-v4.fr-verify .fr-change-number {
    top: auto;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  }
  .fr-auth-v4 .fr-secondary[data-testid=\"fr07-resend\"] {
    top: auto;
    bottom: calc(132px + env(safe-area-inset-bottom, 0px));
  }
  /*
   * PROFILE / FIND — one scroll owner on phone widths.
   * Cancel fixed-stage absolute field/CTA geometry (Continue-over-username, Assist collisions).
   * PROFILE_CONTINUE_OVERLAPS_USERNAME = 0 · CONTACTS_ASSIST_OVERLAP = 0
   */
  .fr-auth-v4.fr-profile,
  .fr-auth-v4.fr-find {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow-x: hidden;
    overflow-y: auto;
    height: 100dvh;
    min-height: 100dvh;
    padding: calc(12px + env(safe-area-inset-top, 0px)) 24px
      calc(28px + env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
  }
  .fr-auth-v4.fr-profile .fr-auth-header,
  .fr-auth-v4.fr-find .fr-auth-header,
  .fr-auth-v4.fr-profile .fr-title,
  .fr-auth-v4.fr-find .fr-title,
  .fr-auth-v4.fr-profile .fr-body,
  .fr-auth-v4.fr-find .fr-body,
  .fr-auth-v4.fr-profile .fr-form,
  .fr-auth-v4.fr-find .fr-form,
  .fr-auth-v4.fr-profile .fr-profile-photo,
  .fr-auth-v4.fr-profile .fr-profile-ring,
  .fr-auth-v4.fr-profile .fr-add-photo-label,
  .fr-auth-v4.fr-profile label,
  .fr-auth-v4.fr-profile input,
  .fr-auth-v4.fr-profile .fr-primary,
  .fr-auth-v4.fr-profile .fr-meta,
  .fr-auth-v4.fr-find .fr-find-card,
  .fr-auth-v4.fr-find .fr-find-actions,
  .fr-auth-v4.fr-find .fr-find-actions .fr-primary,
  .fr-auth-v4.fr-find .fr-find-actions .btn.primary.fr-primary,
  .fr-auth-v4.fr-find .fr-not-now,
  .fr-auth-v4.fr-find .fr-assist-enable,
  .fr-auth-v4.fr-find .fr-assist-dismiss {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    width: 100%;
    max-width: 346px;
    margin-left: auto;
    margin-right: auto;
    height: auto;
  }
  .fr-auth-v4.fr-profile .fr-profile-photo {
    width: auto;
    max-width: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 4px auto 12px;
  }
  .fr-auth-v4.fr-profile .fr-profile-ring {
    width: 96px;
    height: 96px;
    margin: 0 auto;
  }
  .fr-auth-v4.fr-profile .fr-profile-edit {
    position: absolute;
    top: auto;
    left: auto;
    right: calc(50% - 48px - 4px);
    bottom: 0;
    width: 30px;
    height: 30px;
  }
  .fr-auth-v4.fr-profile .fr-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 0 0 auto;
    margin-top: 0;
  }
  .fr-auth-v4.fr-profile .fr-primary {
    height: 58px;
    min-height: 58px;
    margin-top: 16px;
  }
  .fr-auth-v4.fr-find .fr-find-actions .fr-primary {
    height: 58px;
    min-height: 58px;
    margin-top: auto;
  }
  .fr-auth-v4.fr-find .fr-find-card {
    min-height: 92px;
    height: auto;
    margin: 0 auto 12px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
  }
  .fr-auth-v4.fr-find .fr-find-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px auto 0;
  }

  .fr-splash-aura {
    top: calc(108px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mark {
    top: calc(128px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-wordmark {
    top: calc(338px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mechanic,
  .fr-splash-tagline {
    top: calc(408px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-skip {
    top: calc(64px + env(safe-area-inset-top, 0px));
    bottom: auto;
    right: 24px;
    left: auto;
  }
  .fr-splash-tap {
    top: auto;
    bottom: calc(100px + env(safe-area-inset-bottom, 0px));
  }
  .fr-splash-returning {
    top: auto;
    bottom: calc(40px + env(safe-area-inset-bottom, 0px));
  }

  .first-run-promise-page {
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    overflow-x: hidden;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .first-run-promise-clip {
    max-height: calc(100dvh - 140px);
    width: min(390px, 100%, calc((100dvh - 140px) * 941 / 1490));
    flex: 0 1 auto;
  }
  .first-run-promise-img {
    width: 100%;
    margin: 0;
    height: auto;
  }
  .first-run-promise-status-crop {
    height: 40px;
  }
  .first-run-promise-cta {
    position: relative;
    top: auto;
    bottom: auto;
    left: auto;
    margin: 12px auto calc(8px + env(safe-area-inset-bottom, 0px));
    flex-shrink: 0;
  }
}

.app-first-run-splash .app-ambient,
.app-first-run-splash .fr-void {
  display: none !important;
}

.app-futura {
  background:
    radial-gradient(120% 80% at 50% -20%, rgba(110, 232, 245, 0.09), transparent 55%),
    radial-gradient(90% 60% at 100% 100%, rgba(139, 124, 255, 0.07), transparent 50%),
    radial-gradient(60% 40% at 0% 100%, rgba(61, 222, 153, 0.03), transparent 45%),
    var(--bg);
}

/**
 * P0 / 594:2 + Home 287:6  -  no invented full-height cyan/violet side rails.
 * Spectral meaning is discovered on signal objects, not sprayed as permanent feed edges.
 */
.app-ambient {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: transparent;
  z-index: 0;
}

/* Tabbar, call surface, and conversation exact chrome must keep absolute positioning.
 * Relative hammer previously: dock → y748/w356; Direct header scrolled off-screen with thread. */
.app > *:not(.app-ambient):not(.call-surface):not(.tabbar):not(.gpt-header):not(.composer):not(.thread):not(.gpt-shared-graph-plate):not(.dated-conv):not(.group-info-dest):not(.graph-create-flow):not(.you-pane-nested):not(.profile-person-overlay):not(.opal-ambient-destination):not(.opal-ambient-overlay):not(.ogsn-graph-detail):not(.new-call-dest):not(.call-continuity-dest):not(.search-dest-373-261):not(.activity-dest-473-141):not(.memory-comments-sheet):not(.forward-share-picker):not(.memory-detail-sheet):not(.discovery-detail-sheet):not(.saved-browse-sheet):not(.save-to-collection-sheet):not(.story-viewer):not(.story-create-flow):not(.full-live-destination):not(.trip-canvas) {
  position: relative;
  z-index: 1;
}

.glass {
  background: var(--glass);
  backdrop-filter: blur(18px) saturate(1.2);
  -webkit-backdrop-filter: blur(18px) saturate(1.2);
  border-color: var(--border);
}

/*  -  -  Brand  -  -  */
.opal-lockup {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Walkthrough brand-arrival: wordmark under mark, commands the first seconds */
.opal-lockup--hero {
  flex-direction: column;
  gap: 14px;
  position: relative;
  z-index: 1;
}

.opal-lockup--hero .opal-wordmark,
.scene-brand-wordmark {
  font-size: clamp(1.75rem, 6vw, 2.35rem);
  font-weight: 700;
  letter-spacing: -0.045em;
  text-transform: none;
}

.opal-wordmark {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.045em;
  background: linear-gradient(120deg, #f2f6fa 0%, #9ae8f2 55%, #c8d0ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.opal-mark--glow {
  filter: drop-shadow(0 0 10px rgba(94, 214, 232, 0.35));
}

/*  -  -  Top bar  -  -  */
.topbar {
  height: var(--topbar-h);
  min-height: var(--topbar-h);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  border-bottom: 1px solid var(--border);
  z-index: 2;
}

.topbar-brand {
  display: flex;
  align-items: center;
  gap: 8px;
}

.topbar-brand-word {
  font-size: 1.05rem;
  font-weight: 650;
  letter-spacing: -0.03em;
  color: var(--text, #f4f7fa);
}

.brand-title {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.pane {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.scroll {
  flex: 1;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  padding: 14px 16px calc(var(--tabbar-h) + 18px);
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
}

.screen-title {
  margin: 4px 0 8px;
  font-size: 1.85rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.greeting {
  margin: 8px 0 6px;
  font-size: 1.55rem;
  font-weight: 700;
  letter-spacing: -0.035em;
}

.greeting-name {
  background: linear-gradient(120deg, var(--accent-soft), var(--iris));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.lede {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.45;
}

.muted-lede {
  margin-top: -4px;
  margin-bottom: 16px;
  font-size: 0.88rem;
}

.section {
  margin-bottom: 22px;
}

.section-label {
  margin: 0 0 10px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent-soft);
  opacity: 0.85;
}

.empty {
  color: var(--muted);
  font-size: 0.95rem;
  padding: 12px 0;
}

/*  -  -  Cards / rows  -  -  */
.card,
.lumen-card {
  background: linear-gradient(
    155deg,
    rgba(24, 32, 44, 0.95) 0%,
    rgba(14, 18, 28, 0.98) 100%
  );
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: 0 0 0 1px rgba(94, 214, 232, 0.03), 0 8px 28px rgba(0, 0, 0, 0.25);
}

.card h4 {
  margin: 0 0 6px;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.4;
}

.dot {
  margin: 0 6px;
  opacity: 0.5;
}

.row-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.btn {
  min-height: 44px;
  padding: 0 16px;
  border-radius: 999px;
  border: 1px solid transparent;
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform var(--motion), background var(--motion), border-color var(--motion),
    box-shadow var(--motion);
}

.btn:active {
  transform: scale(0.98);
}

.dock-tab:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.chats-home-row:active {
  transform: scale(0.98);
  opacity: 0.92;
}

@media (prefers-reduced-motion: reduce) {
  .btn:active,
  .dock-tab:active,
  .chats-home-row:active {
    transform: none;
  }
}

.btn.primary {
  background: linear-gradient(135deg, #3aa8bc 0%, #5ed6e8 55%, #8b9cff 130%);
  color: #041018;
  box-shadow: 0 0 20px rgba(94, 214, 232, 0.28);
}

.btn.primary:hover {
  box-shadow: 0 0 28px rgba(94, 214, 232, 0.4);
}

.btn.ghost {
  background: transparent;
  border-color: var(--border-bright);
  color: var(--text);
}

.btn.ghost:hover {
  border-color: var(--accent);
  color: var(--accent-soft);
}

/*  -  -  Chat list  -  -  */
.chat-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chat-row,
.lumen-row {
  width: 100%;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  text-align: left;
  padding: 12px 12px;
  border: 1px solid transparent;
  border-radius: 16px;
  background: rgba(14, 18, 28, 0.45);
  transition: background var(--motion), border-color var(--motion), box-shadow var(--motion),
    transform var(--motion);
  min-height: 72px;
}

.chat-row:hover {
  background: rgba(20, 28, 40, 0.75);
  border-color: var(--border);
  box-shadow: 0 0 24px rgba(94, 214, 232, 0.06);
}

.chat-row:active {
  transform: scale(0.99);
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  background: linear-gradient(145deg, #1a2434, #0e1520);
  border: 1px solid var(--border);
  color: var(--accent-soft);
}

.avatar-lumen {
  background:
    radial-gradient(circle at 30% 25%, rgba(94, 214, 232, 0.25), transparent 55%),
    linear-gradient(145deg, #1a2438, #0c121c);
  box-shadow: inset 0 0 0 1px rgba(94, 214, 232, 0.12);
}

.avatar.lg {
  width: 56px;
  height: 56px;
  font-size: 1rem;
  border-radius: 18px;
}

.chat-meta {
  flex: 1;
  min-width: 0;
}

.chat-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 3px;
}

.chat-name {
  font-weight: 600;
  letter-spacing: -0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-time {
  color: var(--muted);
  font-size: 0.75rem;
  flex-shrink: 0;
}

.chat-bottom {
  display: flex;
  align-items: center;
  gap: 8px;
}

.chat-preview {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: 0.88rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-preview.unread {
  color: var(--text);
  font-weight: 500;
}

.badge-count {
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--accent-deep), var(--accent));
  color: #041018;
  font-size: 0.72rem;
  font-weight: 700;
  display: grid;
  place-items: center;
  box-shadow: 0 0 12px rgba(94, 214, 232, 0.35);
}

/*  -  -  Signal chips (legacy class kept for tests)  -  -  */
.signal-chip {
  display: inline-flex;
  align-items: center;
  margin-top: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  border: 1px solid rgba(94, 214, 232, 0.28);
  background: rgba(94, 214, 232, 0.1);
  color: var(--accent-soft);
  width: fit-content;
}

.signal-chip.row {
  margin-top: 8px;
}

/* Opal moment: shared social progress  -  not a human bubble, not an identity label. */
.opal-moment {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 6px 0 2px;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  border: 1px solid rgba(94, 214, 232, 0.28);
  background: linear-gradient(
    120deg,
    rgba(94, 214, 232, 0.08),
    rgba(120, 140, 255, 0.06)
  );
  color: var(--accent-soft);
  width: fit-content;
  max-width: 100%;
  box-shadow: 0 0 18px rgba(94, 214, 232, 0.08);
}

.opal-moment.row {
  margin-top: 8px;
}

.opal-moment.journey {
  display: flex;
  margin: 0;
  padding: 8px 14px;
  border-radius: 0;
  border-left: none;
  border-right: none;
  border-top: none;
  width: 100%;
  max-width: none;
  justify-content: center;
  background: rgba(8, 16, 28, 0.55);
  backdrop-filter: blur(8px);
}

.opal-moment.inline {
  align-self: center;
  margin: 8px auto;
}

.opal-moment.static {
  margin-bottom: 8px;
}

.opal-moment-mark {
  font-size: 0.65rem;
  opacity: 0.85;
  color: var(--accent);
}

.opal-moment-label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.opal-progress-card .opal-moment {
  margin-bottom: 10px;
}

/* Clickable shared-reality cards  -  same visual as cards, full-width action */
button.plan-card-btn {
  display: block;
  width: 100%;
  text-align: left;
  cursor: pointer;
  font: inherit;
  color: inherit;
  appearance: none;
}

button.plan-card-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.plan-title {
  margin: 0 0 4px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
}

.plan-detail {
  margin: 0;
  font-size: 0.9rem;
  color: var(--muted);
}

.small-lede {
  font-size: 0.85rem;
  margin-bottom: 12px;
}

.signal-plan_forming,
.signal-open_loop {
  border-color: rgba(94, 214, 232, 0.3);
  color: var(--accent-soft);
}

/* P3: Ready/confirmed → GOLD (earned). Emerald reserved for Set completion, not confirmation. */
.signal-ready {
  border-color: color-mix(in srgb, var(--signal-confirmed) 35%, transparent);
  background: color-mix(in srgb, var(--signal-confirmed) 12%, transparent);
  color: var(--signal-confirmed);
}

.signal-follow_through,
.signal-moment {
  border-color: rgba(212, 180, 131, 0.35);
  background: rgba(212, 180, 131, 0.1);
  color: var(--pearl);
}

/* Availability overlap: recognition (cyan→violet), never completion emerald. */
.signal-availability_overlap,
.signal-option_surfaced {
  border-color: rgba(139, 92, 246, 0.32);
  background: linear-gradient(
    120deg,
    rgba(94, 214, 232, 0.07),
    rgba(139, 92, 246, 0.09)
  );
  color: var(--iris, #8b9cff);
}

/* Authoritative Set only  -  emerald reserved for real Set. */
.signal-set {
  border-color: rgba(62, 207, 154, 0.35);
  background: rgba(62, 207, 154, 0.1);
  color: #7eecc0;
}

.opal-moment.has-detail {
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}

.opal-moment.has-detail .opal-moment-label {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.opal-moment-detail {
  font-size: 0.68rem;
  font-weight: 500;
  opacity: 0.82;
}

.opal-moment.journey.as-button {
  cursor: pointer;
  font: inherit;
  color: inherit;
  appearance: none;
  -webkit-appearance: none;
}

.opal-moment.journey.as-button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}

.availability-hint {
  text-align: center;
  margin: 0;
  padding: 4px 14px 8px;
  font-size: 0.72rem;
  opacity: 0.75;
}

.availability-list {
  list-style: none;
  margin: 0 0 12px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.availability-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
}

.availability-steps {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.availability-steps .is-active {
  border-color: rgba(94, 214, 232, 0.4);
}

/* Opal-moment motion language (Controlled)  -  quiet, one-shot, no confetti. */
.opal-moment.moment-enter {
  animation: opal-moment-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.opal-moment.signal-availability_overlap.moment-enter::after {
  content: \"\";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    100deg,
    transparent 40%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 60%
  );
  animation: opal-moment-refraction 500ms ease-out 60ms both;
}

@keyframes opal-moment-enter {
  from {
    opacity: 0;
    transform: translateY(-1px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes opal-moment-refraction {
  from {
    opacity: 0;
    transform: translateX(-30%);
  }
  to {
    opacity: 1;
    transform: translateX(30%);
  }
}

/*  -  -  Opal UI Grammar  -  -  */

/*
 * Opal Edge: resting glow ALWAYS present when .opal-edge (survives reduced-motion).
 * One-shot refraction + soft entrance only when .opal-edge-animate (real threshold).
 */
.opal-moment.journey.opal-edge {
  position: relative;
  overflow: hidden;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 0 26px rgba(94, 214, 232, 0.22);
  border-bottom-color: rgba(94, 214, 232, 0.45);
}

.opal-moment.journey.opal-edge.opal-edge-animate::after {
  content: \"\";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    100deg,
    transparent 35%,
    rgba(255, 255, 255, 0.16) 50%,
    transparent 65%
  );
  animation: opal-moment-refraction 480ms ease-out both;
}

/* Context chip above composer  -  one forward action; ≥44px touch. */
.opal-context-chip-wrap {
  display: flex;
  justify-content: flex-start;
  padding: 0 12px 8px;
  gap: 8px;
}

/* Edge lives as ambient on the chip wrap  -  not a separate status strip. */
.opal-context-chip-wrap.opal-chip-edge {
  position: relative;
}

.opal-context-chip-wrap.opal-chip-edge .opal-context-chip {
  box-shadow:
    0 0 22px rgba(94, 214, 232, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
  border-color: rgba(94, 214, 232, 0.42);
}

.opal-context-chip-wrap.opal-chip-edge.opal-edge-animate::after {
  content: \"\";
  position: absolute;
  inset: 0 8px;
  border-radius: 999px;
  pointer-events: none;
  background: linear-gradient(
    100deg,
    transparent 30%,
    rgba(255, 255, 255, 0.14) 50%,
    transparent 70%
  );
  animation: opal-moment-refraction 480ms ease-out both;
}

.opal-context-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  min-width: 44px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid rgba(94, 214, 232, 0.32);
  background: rgba(10, 14, 22, 0.94);
  color: var(--accent-soft, #b8e8f0);
  font: inherit;
  font-size: 0.82rem;
  font-weight: 650;
  cursor: pointer;
  box-shadow: 0 0 18px rgba(94, 214, 232, 0.08);
}

.opal-context-chip:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/*
 * Private Guidance (Screen 4)  -  Private Opal physics (inward violet).
 * Expand in-thread; NO nested scroll (conversation owns vertical scroll).
 */
.opal-private-guidance {
  position: relative;
  align-self: center;
  width: min(100%, 20rem);
  margin: 10px auto 8px;
  padding: 14px 36px 14px 14px;
  border-radius: 16px;
  border: none;
  overflow: visible;
  max-height: none;
  color: #c4b5fd;
  background:
    radial-gradient(
      100% 90% at 18% 0%,
      rgba(167, 139, 250, 0.22),
      transparent 55%
    ),
    radial-gradient(
      80% 70% at 90% 100%,
      rgba(91, 33, 182, 0.14),
      transparent 50%
    ),
    rgba(14, 10, 24, 0.94);
  box-shadow:
    inset 0 0 32px rgba(139, 92, 246, 0.12),
    0 0 0 1px rgba(167, 139, 250, 0.4),
    0 0 28px rgba(139, 92, 246, 0.14);
  animation: opal-moment-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* One-shot inward violet refraction (alive, not looping) */
.opal-private-guidance::before {
  content: \"\";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(196, 181, 253, 0.14) 48%,
    rgba(139, 92, 246, 0.08) 55%,
    transparent 70%
  );
  animation: opal-moment-refraction 520ms ease-out 60ms both;
}

.opal-private-guidance.is-quiet {
  box-shadow:
    inset 0 0 16px rgba(139, 92, 246, 0.05),
    0 0 0 1px rgba(139, 92, 246, 0.22);
  animation: none;
}

.opal-private-guidance.is-quiet::before {
  content: none;
  animation: none;
}

.opal-private-guidance-kicker {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.opal-private-mark {
  color: #8b5cf6;
  font-weight: 800;
  font-size: 0.85rem;
  line-height: 1;
}

.opal-private-label {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: #e9e0ff;
  letter-spacing: -0.01em;
  line-height: 1.35;
}

.opal-private-hint {
  margin: 0;
  font-size: 0.75rem;
  opacity: 0.95;
  color: #a78bfa;
  font-weight: 500;
}

.opal-private-close-x {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 36px;
  height: 36px;
  min-width: 36px;
  min-height: 36px;
  padding: 0;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: rgba(167, 139, 250, 0.75);
  font: inherit;
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
}

.opal-private-close-x:focus-visible {
  outline: 2px solid rgba(167, 139, 250, 0.75);
  outline-offset: 2px;
}

.opal-private-soft-action {
  margin-top: 10px;
  min-height: 40px;
  padding: 8px 14px;
  border: none;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.14);
  color: #ddd6fe;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.35);
}

.opal-private-soft-action:focus-visible {
  outline: 2px solid rgba(167, 139, 250, 0.75);
  outline-offset: 2px;
}

/* Chip in-thread (Screen 2)  -  same chip styles, thread placement only */
.thread .opal-context-chip-wrap {
  justify-content: center;
  padding: 6px 0 4px;
}

/* ============================================================
 * OPAL MATERIAL SYSTEM (internal primitives  -  not public labels)
 * TRACE · FIELD · POSSIBILITY · REVEAL · RESOLUTION · PRIVATE
 * ============================================================ */

/* OPAL REVEAL  -  one intelligence field; possibilities emerge inside */
.opal-insight-field {
  --opal-ease: cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  align-self: center;
  width: min(100%, 20.5rem);
  margin: 10px auto 14px;
  padding: 14px 14px 12px;
  border-radius: 18px;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(
      120% 90% at 18% 0%,
      rgba(94, 214, 232, 0.1),
      transparent 55%
    ),
    radial-gradient(
      90% 80% at 92% 100%,
      rgba(139, 92, 246, 0.08),
      transparent 50%
    ),
    rgba(8, 12, 20, 0.55);
  box-shadow:
    0 0 0 1px rgba(94, 214, 232, 0.12),
    0 12px 36px rgba(0, 0, 0, 0.28),
    0 0 40px rgba(94, 214, 232, 0.06);
  animation: opal-field-enter 360ms var(--opal-ease) both;
}

/* Ambient after field enter  -  one light event at a time (budget). */
.opal-insight-field.has-ambient::before {
  content: \"\";
  position: absolute;
  inset: -18% -10% auto -10%;
  height: 70%;
  pointer-events: none;
  z-index: 0;
  background: radial-gradient(
    ellipse at 40% 0%,
    rgba(94, 214, 232, 0.2),
    rgba(139, 92, 246, 0.08) 45%,
    transparent 70%
  );
  animation: opal-ambient-settle 520ms var(--opal-ease) 200ms both;
}

/* Thin spectral rim  -  not a hard card border */
.opal-insight-field::after {
  content: \"\";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  padding: 1px;
  background: linear-gradient(
    125deg,
    rgba(94, 214, 232, 0.55),
    rgba(180, 160, 255, 0.22) 42%,
    rgba(94, 214, 232, 0.12) 70%,
    rgba(126, 236, 192, 0.18)
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.9;
}

/* Refraction only after ambient settles  -  not concurrent with field enter */
.opal-insight-ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0;
  background: linear-gradient(
    100deg,
    transparent 30%,
    rgba(255, 255, 255, 0.07) 50%,
    transparent 70%
  );
  animation: opal-moment-refraction 480ms ease-out 720ms both;
}

.opal-insight-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 4px;
}

.opal-insight-phrase {
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--pearl, #e8eef5);
  line-height: 1.35;
}

.opal-insight-field .opal-group-share-count {
  position: relative;
  z-index: 1;
  margin: 2px 0 8px;
  opacity: 0.72;
}

.opal-possibility-cluster {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}

.opal-possibility-cluster.is-multi {
  gap: 4px;
  padding-top: 4px;
  /* Faint shared light spine  -  options emerge from one origin */
  background: linear-gradient(
    180deg,
    rgba(94, 214, 232, 0.06),
    transparent 40%,
    transparent 60%,
    rgba(139, 92, 246, 0.05)
  );
  border-radius: 14px;
}

/*  -  -  OPAL POSSIBILITY  -  -  text in refractive field, not a filled button */
.opal-possibility {
  --opal-stagger: 0ms;
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 48px;
  margin: 0;
  padding: 12px 14px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: var(--pearl, #e8eef5);
  font: inherit;
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
  transition:
    transform 160ms var(--opal-ease, cubic-bezier(0.16, 1, 0.3, 1)),
    opacity 280ms var(--opal-ease, cubic-bezier(0.16, 1, 0.3, 1)),
    filter 280ms ease;
}

.opal-possibility-contour {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0.85;
  background: linear-gradient(
    115deg,
    rgba(94, 214, 232, 0.45),
    rgba(167, 139, 250, 0.2) 50%,
    rgba(94, 214, 232, 0.12)
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  padding: 1px;
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  transition: opacity 200ms ease, filter 200ms ease;
}

.opal-possibility-field {
  position: absolute;
  inset: 1px;
  border-radius: 13px;
  pointer-events: none;
  background:
    linear-gradient(
      165deg,
      rgba(94, 214, 232, 0.07),
      rgba(12, 16, 26, 0.35) 55%,
      rgba(139, 92, 246, 0.05)
    );
  opacity: 0.9;
  transition: opacity 200ms ease, background 220ms ease;
}

.opal-possibility-label {
  position: relative;
  z-index: 1;
  background: linear-gradient(
    100deg,
    #e8eef5 0%,
    #b8e8f0 45%,
    #d4c4fc 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  /* Fallback if clip unsupported */
  filter: none;
}

@supports not (background-clip: text) {
  .opal-possibility-label {
    color: var(--pearl, #e8eef5);
    background: none;
  }
}

/* Reveal: possibilities separate from shared field */
.opal-possibility.is-reveal {
  animation: opal-possibility-emerge 420ms var(--opal-ease, cubic-bezier(0.16, 1, 0.3, 1))
    both;
  animation-delay: var(--opal-stagger, 0ms);
}

/* Touch-down: depth compression + light response (mobile-first) */
.opal-possibility.is-pressed,
.opal-possibility:active:not(:disabled) {
  transform: scale(0.985) translateY(0.5px);
}

.opal-possibility.is-pressed .opal-possibility-contour,
.opal-possibility:active:not(:disabled) .opal-possibility-contour {
  opacity: 1;
  filter: brightness(1.15);
}

.opal-possibility.is-pressed .opal-possibility-field,
.opal-possibility:active:not(:disabled) .opal-possibility-field {
  background:
    linear-gradient(
      165deg,
      rgba(94, 214, 232, 0.16),
      rgba(16, 22, 34, 0.5) 50%,
      rgba(139, 92, 246, 0.1)
    );
}

/* Chosen: light gathers on this path (recognition cyan/violet only  -  never Set emerald) */
.opal-possibility.is-chosen {
  transform: translateY(-1px);
}

.opal-possibility.is-chosen .opal-possibility-contour {
  opacity: 1;
  background: linear-gradient(
    115deg,
    rgba(94, 214, 232, 0.9),
    rgba(167, 139, 250, 0.5) 48%,
    rgba(94, 214, 232, 0.35)
  );
  animation: opal-possibility-converge 420ms var(--opal-ease, cubic-bezier(0.16, 1, 0.3, 1))
    both;
}

.opal-possibility.is-chosen .opal-possibility-field {
  background:
    linear-gradient(
      165deg,
      rgba(94, 214, 232, 0.18),
      rgba(14, 20, 30, 0.55) 55%,
      rgba(139, 92, 246, 0.1)
    );
  box-shadow:
    inset 0 0 28px rgba(94, 214, 232, 0.12),
    0 0 20px rgba(94, 214, 232, 0.1);
  animation: opal-possibility-gather 420ms var(--opal-ease, cubic-bezier(0.16, 1, 0.3, 1))
    both;
}

.opal-possibility.is-chosen .opal-possibility-label {
  background: linear-gradient(100deg, #f2f8fc, #9ee7f2 40%, #c4b5fd);
  -webkit-background-clip: text;
  background-clip: text;
}

/* Receding: quieter, not error/disabled cemetery */
.opal-possibility.is-receding {
  opacity: 0.28;
  transform: scale(0.98);
  filter: saturate(0.55);
  pointer-events: none;
}

.opal-possibility.is-receding .opal-possibility-contour {
  opacity: 0.35;
}

.opal-possibility:focus-visible {
  outline: 2px solid rgba(94, 214, 232, 0.75);
  outline-offset: 3px;
}

/* Field converges after choice */
.opal-insight-field.is-converging {
  box-shadow:
    0 0 0 1px rgba(94, 214, 232, 0.22),
    0 10px 28px rgba(0, 0, 0, 0.3),
    0 0 48px rgba(94, 214, 232, 0.1);
}

.opal-insight-field.is-resolved {
  animation: opal-field-contract 320ms var(--opal-ease) both;
  animation-delay: 120ms;
}

/* Discovery (single strong option)  -  not a one-row list */
.opal-insight-field.is-discovery .opal-possibility-cluster {
  margin-top: 12px;
}

.opal-insight-field.is-discovery .opal-possibility {
  min-height: 52px;
}

/* Composer continuum: soft top edge when Opal action present */
.composer.has-opal-context {
  box-shadow:
    0 -12px 28px rgba(94, 214, 232, 0.06),
    inset 0 1px 0 rgba(94, 214, 232, 0.12);
}

/* Local ambient when shared Opal insight is live (one event; not full-screen) */
.thread:has(.opal-insight-field.has-ambient) {
  box-shadow: inset 0 -48px 56px rgba(94, 214, 232, 0.045);
}

/* Context chip: solid ambient base + spectral contour (unmistakably Opal) */
.opal-context-chip {
  position: relative;
  overflow: hidden;
  border: 1px solid transparent;
  background:
    linear-gradient(rgba(10, 14, 22, 0.94), rgba(10, 14, 22, 0.94)) padding-box,
    linear-gradient(
      120deg,
      rgba(94, 214, 232, 0.65),
      rgba(139, 92, 246, 0.35),
      rgba(94, 214, 232, 0.4)
    )
    border-box;
  box-shadow:
    0 0 22px rgba(94, 214, 232, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.opal-context-chip-wrap.opal-chip-edge .opal-context-chip {
  background:
    linear-gradient(
      165deg,
      rgba(16, 28, 40, 0.96),
      rgba(10, 14, 22, 0.94)
    )
    padding-box,
    linear-gradient(
      115deg,
      rgba(94, 214, 232, 0.75),
      rgba(167, 139, 250, 0.4),
      rgba(94, 214, 232, 0.45)
    )
    border-box;
  box-shadow:
    0 0 28px rgba(94, 214, 232, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

/* ============================================================
 * OPAL RESOLUTION (Set)  -  coherence, not a success badge
 * ============================================================ */
.opal-resolution {
  --opal-ease: cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  align-self: stretch;
  margin: 0;
  padding: 18px 16px 16px;
  overflow: hidden;
  isolation: isolate;
  text-align: center;
  background:
    radial-gradient(
      80% 120% at 50% 0%,
      rgba(126, 236, 192, 0.1),
      transparent 60%
    ),
    rgba(6, 14, 12, 0.55);
  border-bottom: 1px solid rgba(126, 236, 192, 0.28);
  animation: opal-resolution-enter 520ms var(--opal-ease) both;
}

.opal-resolution-ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    100deg,
    transparent 25%,
    rgba(126, 236, 192, 0.12) 50%,
    transparent 75%
  );
  animation: opal-resolution-converge 640ms var(--opal-ease) both;
}

.opal-resolution-core {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.opal-resolution-mark {
  font-size: 0.7rem;
  color: #7eecc0;
  opacity: 0.9;
  letter-spacing: 0;
  animation: opal-resolution-mark 480ms var(--opal-ease) both;
}

.opal-resolution-label {
  font-size: 1.15rem;
  font-weight: 650;
  letter-spacing: 0.12em;
  text-transform: none;
  color: #c8f5e0;
  text-shadow: 0 0 24px rgba(126, 236, 192, 0.25);
}

.opal-resolution-detail {
  margin-top: 2px;
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  color: rgba(184, 245, 216, 0.85);
}

/* After hold: quieter permanence  -  not a permanent giant object */
.opal-resolution.phase-calm {
  padding: 10px 14px;
  background: rgba(6, 14, 12, 0.42);
  border-bottom-color: rgba(126, 236, 192, 0.22);
  transition:
    padding 400ms var(--opal-ease),
    background 400ms ease,
    border-color 400ms ease;
}

.opal-resolution.phase-calm .opal-resolution-ambient {
  opacity: 0;
}

.opal-resolution.phase-calm .opal-resolution-label {
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  text-shadow: none;
  transition: font-size 400ms var(--opal-ease), letter-spacing 400ms ease;
}

.opal-resolution.phase-calm .opal-resolution-mark {
  font-size: 0.62rem;
}

/* Composer briefly catches resolved color */
.composer.has-opal-set {
  box-shadow:
    0 -10px 24px rgba(126, 236, 192, 0.06),
    inset 0 1px 0 rgba(126, 236, 192, 0.14);
}

/* Legacy journey strip Set (list rows etc.)  -  keep restrained */
.opal-moment.journey.signal-set {
  background: rgba(8, 18, 16, 0.72);
  border-bottom-color: rgba(126, 236, 192, 0.42);
  box-shadow:
    inset 0 1px 0 rgba(126, 236, 192, 0.1),
    0 0 14px rgba(126, 236, 192, 0.08);
}

.opal-moment.journey.signal-set .opal-moment-label {
  color: #b8f5d8;
  letter-spacing: 0.04em;
}

/* ============================================================
 * PRIVATE OPAL FIELD  -  inward violet (for me)
 * Same world as shared REVEAL; privacy = direction, not product switch
 * ============================================================ */
.opal-private-overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: grid;
  place-items: end center;
  padding: 10px 10px 12px;
  background: rgba(4, 2, 10, 0.78);
  animation: opal-private-overlay-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.opal-private-overlay.is-exiting {
  animation: opal-private-overlay-out 360ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.opal-private-field {
  --opal-ease: cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  width: min(420px, 100%);
  /* Default: expand in place  -  no nested scroll inside chat */
  max-height: none;
  overflow: visible;
  padding: 16px 14px 18px;
  border-radius: 22px 22px 18px 18px;
  isolation: isolate;
  background:
    radial-gradient(
      100% 80% at 20% 0%,
      rgba(167, 139, 250, 0.2),
      transparent 55%
    ),
    radial-gradient(
      80% 60% at 90% 100%,
      rgba(91, 33, 182, 0.14),
      transparent 50%
    ),
    rgba(12, 8, 22, 0.96);
  box-shadow:
    0 0 0 1px rgba(167, 139, 250, 0.35),
    0 18px 48px rgba(0, 0, 0, 0.45),
    0 0 36px rgba(139, 92, 246, 0.12),
    inset 0 0 40px rgba(139, 92, 246, 0.08);
  animation: opal-private-field-in 380ms var(--opal-ease) both;
}

/* Focused private sheet (modal): that surface owns scroll; chat is inactive behind */
.opal-private-overlay .opal-private-field {
  max-height: min(88dvh, 720px);
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.opal-private-overlay.is-exiting .opal-private-field {
  animation: opal-private-field-out 340ms var(--opal-ease) both;
}

.opal-private-field-ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(
    105deg,
    transparent 28%,
    rgba(196, 181, 253, 0.14) 48%,
    rgba(139, 92, 246, 0.1) 55%,
    transparent 72%
  );
  animation: opal-moment-refraction 520ms ease-out 120ms both;
  opacity: 1;
}

.opal-private-field::after {
  content: \"\";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  padding: 1px;
  background: linear-gradient(
    135deg,
    rgba(167, 139, 250, 0.55),
    rgba(91, 33, 182, 0.2) 50%,
    rgba(139, 92, 246, 0.25)
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

.opal-private-field-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 4px;
}

.opal-private-field-title-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
}

.opal-private-field-header h2 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 650;
  letter-spacing: -0.02em;
  color: #e9e0ff;
}

.opal-private-hint-line {
  position: relative;
  z-index: 1;
  margin: 0 0 12px;
  font-size: 0.78rem;
  font-weight: 500;
  color: #a78bfa;
  opacity: 0.95;
}

.opal-private-close {
  flex-shrink: 0;
  min-height: 40px;
  min-width: 44px;
  padding: 8px 12px;
  border: none;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.1);
  color: #c4b5fd;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
}

.opal-private-close:focus-visible {
  outline: 2px solid rgba(167, 139, 250, 0.75);
  outline-offset: 2px;
}

.opal-private-step-trace {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 6px;
  margin-bottom: 14px;
}

.opal-private-step {
  min-height: 36px;
  padding: 6px 12px;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: rgba(196, 181, 253, 0.65);
  font: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.2);
}

.opal-private-step.is-active {
  color: #e9e0ff;
  background: rgba(139, 92, 246, 0.14);
  box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.45);
}

.opal-private-field-body {
  position: relative;
  z-index: 1;
}

.opal-private-possibilities {
  list-style: none;
  margin: 0 0 14px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.opal-private-possibility {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  min-height: 48px;
  margin: 0;
  padding: 10px 12px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: #e9e0ff;
  font: inherit;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

.opal-private-possibility.is-mine {
  cursor: default;
}

.opal-private-possibility-contour {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  padding: 1px;
  background: linear-gradient(
    120deg,
    rgba(167, 139, 250, 0.45),
    rgba(91, 33, 182, 0.2),
    rgba(139, 92, 246, 0.28)
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.75;
}

.opal-private-possibility.is-selected .opal-private-possibility-contour {
  opacity: 1;
  background: linear-gradient(
    120deg,
    rgba(196, 181, 253, 0.75),
    rgba(139, 92, 246, 0.45),
    rgba(167, 139, 250, 0.4)
  );
}

.opal-private-possibility.is-selected {
  background: rgba(139, 92, 246, 0.1);
  box-shadow: inset 0 0 20px rgba(139, 92, 246, 0.08);
}

.opal-private-possibility-label {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: #ddd6fe;
}

.opal-private-select-mark {
  position: relative;
  z-index: 1;
  color: #a78bfa;
  font-size: 0.75rem;
  opacity: 0.85;
}

.opal-private-text-action {
  position: relative;
  z-index: 1;
  min-height: 40px;
  padding: 6px 10px;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: #a78bfa;
  font: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
}

.opal-private-empty {
  padding: 8px 4px;
  font-size: 0.88rem;
  color: rgba(196, 181, 253, 0.65);
}

.opal-private-add {
  margin-bottom: 14px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(139, 92, 246, 0.06);
  box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.18);
}

.opal-private-add-label {
  margin: 0 0 8px;
  font-size: 0.8rem;
  font-weight: 600;
  color: #c4b5fd;
}

.opal-private-inputs {
  display: grid;
  gap: 8px;
  margin-bottom: 10px;
}

.opal-private-input-wrap {
  display: grid;
  gap: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  color: rgba(196, 181, 253, 0.75);
}

.opal-private-input-wrap input {
  min-height: 44px;
  padding: 10px 12px;
  border: none;
  border-radius: 12px;
  background: rgba(8, 6, 16, 0.65);
  color: #e9e0ff;
  font: inherit;
  font-size: 0.9rem;
  box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.28);
  color-scheme: dark;
}

.opal-private-input-wrap input:focus-visible {
  outline: 2px solid rgba(167, 139, 250, 0.7);
  outline-offset: 2px;
}

.opal-private-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: 48px;
  margin: 0;
  padding: 12px 16px;
  border: none;
  border-radius: 999px;
  font: inherit;
  font-size: 0.92rem;
  font-weight: 650;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.opal-private-action.soft {
  background: rgba(139, 92, 246, 0.12);
  color: #ddd6fe;
  box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.35);
  margin-bottom: 0;
}

.opal-private-action.exit {
  margin-top: 4px;
  background: linear-gradient(
    120deg,
    rgba(139, 92, 246, 0.35),
    rgba(91, 33, 182, 0.45)
  );
  color: #f5f3ff;
  box-shadow:
    0 0 24px rgba(139, 92, 246, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.opal-private-action:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.opal-private-action:focus-visible {
  outline: 2px solid rgba(196, 181, 253, 0.8);
  outline-offset: 3px;
}

.opal-private-action-cue {
  opacity: 0.85;
  font-weight: 500;
}

.opal-private-share-context {
  margin: 0 0 10px;
  font-size: 0.8rem;
  color: rgba(196, 181, 253, 0.75);
}

.opal-private-status {
  margin: 12px 0 0;
  font-size: 0.85rem;
  color: #c4b5fd;
}

.opal-private-shared-block {
  margin-top: 18px;
  padding-top: 12px;
  box-shadow: inset 0 1px 0 rgba(139, 92, 246, 0.15);
}

.opal-private-possibility.is-shared-out .opal-private-possibility-label {
  opacity: 0.85;
}

@keyframes opal-field-enter {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes opal-ambient-settle {
  0% {
    opacity: 0;
    transform: scaleY(0.85);
  }
  40% {
    opacity: 1;
  }
  100% {
    opacity: 0.55;
    transform: scaleY(1);
  }
}

@keyframes opal-possibility-emerge {
  from {
    opacity: 0;
    transform: translateY(6px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Contour resolves: pad thickens slightly as light settles on choice */
@keyframes opal-possibility-converge {
  0% {
    padding: 1px;
    filter: brightness(1.2);
    opacity: 0.7;
  }
  55% {
    padding: 1.5px;
    filter: brightness(1.08);
    opacity: 1;
  }
  100% {
    padding: 1.25px;
    filter: brightness(1);
    opacity: 1;
  }
}

/* Internal field gathers light toward center of chosen path */
@keyframes opal-possibility-gather {
  0% {
    box-shadow:
      inset 0 0 8px rgba(94, 214, 232, 0.04),
      0 0 4px rgba(94, 214, 232, 0.02);
  }
  100% {
    box-shadow:
      inset 0 0 28px rgba(94, 214, 232, 0.12),
      0 0 20px rgba(94, 214, 232, 0.1);
  }
}

@keyframes opal-field-contract {
  to {
    opacity: 0;
    transform: translateY(8px) scale(0.97);
  }
}

@keyframes opal-resolution-enter {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes opal-resolution-converge {
  0% {
    opacity: 0;
    transform: scaleX(0.4);
  }
  45% {
    opacity: 0.9;
    transform: scaleX(1.02);
  }
  100% {
    opacity: 0.35;
    transform: scaleX(1);
  }
}

@keyframes opal-resolution-mark {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 0.9;
    transform: scale(1);
  }
}

@keyframes opal-private-overlay-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes opal-private-overlay-out {
  to {
    opacity: 0;
  }
}

@keyframes opal-private-field-in {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes opal-private-field-out {
  to {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }
}

/* Shared-safe group count  -  never a roster */
.opal-group-share-count {
  display: block;
  font-size: 0.7rem;
  opacity: 0.8;
  margin-top: 2px;
  font-weight: 500;
}

/* Relationship Pulse experiment  -  topic ambient only; off by default in product */
.opal-pulse-experiment {
  height: 3px;
  width: 100%;
  border: 0;
  background: linear-gradient(90deg, transparent, rgba(94, 214, 232, 0.35), transparent);
  opacity: 0.55;
}

@media (prefers-reduced-motion: reduce) {
  /* Kill motion only  -  keep Edge resting glow (meaning must survive). */
  .opal-moment.moment-enter {
    animation: none !important;
  }

  .opal-moment.signal-availability_overlap.moment-enter::after,
  .opal-moment.journey.opal-edge.opal-edge-animate::after,
  .opal-context-chip-wrap.opal-chip-edge.opal-edge-animate::after,
  .opal-insight-ambient {
    content: none !important;
    animation: none !important;
  }

  .opal-private-guidance,
  .opal-private-guidance::before,
  .opal-insight-field,
  .opal-insight-field.has-ambient::before,
  .opal-possibility.is-reveal,
  .opal-possibility.is-chosen .opal-possibility-contour,
  .opal-insight-field.is-resolved,
  .opal-moment.journey.signal-set,
  .opal-resolution,
  .opal-resolution-ambient,
  .opal-resolution-mark,
  .opal-private-overlay,
  .opal-private-field,
  .opal-private-field-ambient {
    animation: none !important;
  }

  /* Meaning survives without travel: chosen/receding still distinct */
  .opal-possibility.is-receding {
    opacity: 0.35;
  }

  /* Set still more resolved than overlap without motion */
  .opal-resolution {
    border-bottom-color: rgba(126, 236, 192, 0.4);
  }
  .opal-resolution-label {
    color: #c8f5e0;
  }
}

/*  -  -  Thread  -  -  */
.chat-header {
  height: var(--topbar-h);
  min-height: var(--topbar-h);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 10px 0 6px;
  border-bottom: 1px solid var(--border);
  z-index: 2;
}

.chat-header-meta {
  min-width: 0;
  flex: 1;
}

.chat-header-name {
  font-weight: 600;
  letter-spacing: -0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-header-sub {
  font-size: 0.78rem;
  color: var(--accent-soft);
  opacity: 0.9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.icon-btn {
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 12px;
  background: transparent;
  color: var(--text);
  display: grid;
  place-items: center;
}

.icon-btn:hover {
  background: rgba(255, 255, 255, 0.05);
}

.thread {
  flex: 1 1 auto;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
  padding: 16px 14px 12px;
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(110, 232, 245, 0.06), transparent 60%),
    radial-gradient(ellipse 40% 30% at 90% 80%, rgba(139, 124, 255, 0.05), transparent 55%),
    var(--chat-pane);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bubble-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8px;
  max-width: 92%;
}

.bubble-row.out {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.bubble-row.in {
  align-self: flex-start;
}

.bubble-row.sender-start {
  margin-top: 6px;
}

.bubble-row.continues-sender {
  margin-top: 2px;
}

.bubble-speaker-col {
  flex: 0 0 32px;
  width: 32px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.bubble-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #e8eef5;
  background: linear-gradient(145deg, #2a3548 0%, #1a2230 100%);
  border: 1px solid rgba(138, 150, 168, 0.2);
}

.bubble-avatar-spacer {
  width: 32px;
  height: 8px;
}

.bubble-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  min-width: 0;
  max-width: 100%;
}

.bubble-row.out .bubble-stack {
  align-items: flex-end;
}

.bubble-sender-name {
  font-size: 0.72rem;
  font-weight: 600;
  color: #a8b4c4;
  padding-left: 4px;
  letter-spacing: 0.01em;
}

.bubble {
  padding: 10px 14px 8px;
  border-radius: 20px;
  line-height: 1.4;
  font-size: 0.95rem;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.bubble p {
  margin: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.bubble time {
  display: block;
  margin-top: 4px;
  font-size: 0.68rem;
  opacity: 0.65;
}

.bubble.out {
  background: linear-gradient(145deg, #1f5568 0%, #1a4a5c 100%);
  color: #f2fafc;
  border-bottom-right-radius: 6px;
  box-shadow: 0 0 24px var(--bubble-out-glow);
}

.bubble.in {
  background: var(--bubble-in);
  border: 1px solid var(--border);
  border-bottom-left-radius: 6px;
}

.composer {
  display: flex;
  gap: 8px;
  align-items: center;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
  border-top: 1px solid var(--border);
}

.composer-input {
  flex: 1;
  min-height: 44px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: rgba(10, 14, 22, 0.85);
  padding: 0 16px;
  outline: none;
  transition: border-color var(--motion), box-shadow var(--motion);
}

.composer-input:focus {
  border-color: var(--border-bright);
  box-shadow: 0 0 0 3px rgba(94, 214, 232, 0.12);
}

.composer-input::placeholder {
  color: var(--muted);
}

.send-btn {
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background: linear-gradient(135deg, #3aa8bc, #5ed6e8);
  color: #041018;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: 0 0 16px rgba(94, 214, 232, 0.3);
  transition: opacity var(--motion), transform var(--motion);
}

.send-btn:disabled {
  opacity: 0.35;
  box-shadow: none;
}

.send-btn:not(:disabled):active {
  transform: scale(0.96);
}

/*  -  -  Tabs (S0 Opal Graph shell; create slot deferred until Graph create)  -  -  */
.tabbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: var(--tabbar-h);
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  border-top: 0;
  /* Outside Option B silhouette must stay transparent  -  no black tray. */
  background: transparent;
  padding-bottom: env(safe-area-inset-bottom, 0px);
  z-index: 3;
}

.tabbar[data-create-dock=\"deferred\"] {
  /* Layout reserved for future center create without a dead control */
  gap: 0;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  border: none;
  background: transparent;
  color: #8a96a8;
  font-size: 0.68rem;
  font-weight: 500;
  min-height: 48px;
  min-width: 0;
  transition: color var(--motion);
  cursor: pointer;
}

.tab:focus-visible {
  outline: 2px solid rgba(110, 232, 245, 0.55);
  outline-offset: -4px;
  border-radius: 10px;
}

.tab.active {
  color: var(--accent);
  text-shadow: none;
}

.tab.active svg {
  filter: none;
  stroke: var(--accent);
}

/* S0 brand wordmark */
.opal-graph-wordmark {
  display: inline-flex;
  align-items: baseline;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #f2f7fc;
  line-height: 1.1;
  white-space: nowrap;
}

/* Figma 161:2 / 161:3  -  Opal spectral lock (cyan → indigo → magenta) */
.opal-graph-word-opal {
  background-image: linear-gradient(
    90deg,
    #40f2ff 12.5%,
    #7a70ff 43.75%,
    #f273ff 77.5%,
    #c7dbff 112.5%
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.opal-graph-word-graph {
  color: #f5f7fc;
  font-weight: 500;
}

.opal-graph-wordmark.is-compact {
  letter-spacing: 0.01em;
}

.opal-lockup--graph {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.opal-lockup--with-word {
  gap: 12px;
}

.opal-lockup-type {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.opal-graph-tagline {
  margin: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #c5d0dc;
}

/* Legacy 217:* splash overrides REMOVED  -  P0-05.8 uses exact 618:19 rules above */

.topbar-brand-word {
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #f2f7fc;
}

.topbar-brand-word .is-graph {
  color: #c5d0dc;
  font-weight: 500;
}

.opal-mark--graph {
  object-fit: contain;
  flex-shrink: 0;
}

/*  -  -  Profile / settings  -  -  */
.profile-card {
  display: flex;
  gap: 14px;
  align-items: center;
}

.settings-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 52px;
  padding: 12px 14px;
  margin-bottom: 6px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: rgba(14, 18, 28, 0.6);
  text-align: left;
  transition: border-color var(--motion), background var(--motion);
}

.settings-row:hover {
  border-color: var(--border-bright);
  background: rgba(20, 28, 40, 0.75);
}

.muted {
  color: var(--muted);
  font-size: 0.85rem;
}

.session-pill {
  margin-left: auto;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent-soft);
  border: 1px solid rgba(94, 214, 232, 0.35);
  border-radius: 999px;
  padding: 4px 10px;
}

.activation {
  padding: 24px 18px 40px;
  max-width: 400px;
  margin: 0 auto;
}

.activation-hero {
  text-align: center;
  margin-bottom: 22px;
}

.activation-hero h1 {
  margin: 14px 0 8px;
  font-size: 1.45rem;
  letter-spacing: -0.03em;
}

.activation-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.activation-form label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.activation-error {
  color: #f0a0a0;
  background: rgba(224, 107, 107, 0.12);
  border: 1px solid rgba(224, 107, 107, 0.35);
  border-radius: 12px;
  padding: 10px 12px;
  margin: 0 16px 12px;
  font-size: 0.9rem;
}

.activation-status {
  color: var(--accent-soft);
  margin: 0 16px 10px;
  font-size: 0.9rem;
}

.activation-hint {
  margin: 0;
  font-size: 0.82rem;
  color: var(--muted);
}

.activation-trust {
  margin: 0 0 8px;
  font-size: 0.88rem;
  line-height: 1.45;
  color: var(--muted);
  max-width: 28rem;
}

.session-pill {
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--accent-soft);
  border: 1px solid var(--border-bright);
  border-radius: 999px;
  padding: 4px 10px;
}

.dev-code {
  font-size: 0.85rem;
  color: var(--pearl);
  background: rgba(232, 213, 196, 0.08);
  border-radius: 12px;
  padding: 10px 12px;
  margin: 0;
}

/*  -  -  First-run onboarding  -  -  */
.first-run {
  position: absolute;
  inset: 0;
  z-index: 40;
  display: flex;
  flex-direction: column;
  background: #05060a;
  overflow: hidden;
}

.first-run-mesh {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 90% 55% at 50% -10%, rgba(94, 214, 232, 0.18), transparent 55%),
    radial-gradient(ellipse 60% 40% at 10% 90%, rgba(139, 156, 255, 0.12), transparent 50%),
    radial-gradient(ellipse 50% 35% at 95% 60%, rgba(232, 213, 196, 0.06), transparent 45%);
  pointer-events: none;
}

.first-run-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  z-index: 1;
}

.first-run-skip {
  min-height: 40px;
  padding: 0 14px;
}

.first-run-stage {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 22px 12px;
  z-index: 1;
}

.first-run-panel {
  width: 100%;
  max-width: 360px;
  text-align: center;
}

.first-run-kicker {
  margin: 18px 0 8px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent-soft);
}

.first-run-title {
  margin: 0 0 12px;
  font-size: 1.65rem;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.2;
  /* Long conversion headline: keep impact; wrap intentionally on narrow viewports. */
  text-wrap: balance;
}

.first-run-body {
  margin: 0;
  color: var(--muted);
  font-size: 0.98rem;
  line-height: 1.5;
}

.first-run-foot {
  position: relative;
  z-index: 1;
  padding: 12px 20px calc(20px + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: center;
}

.first-run-skip-spacer {
  width: 3.5rem;
  height: 1px;
}

/* Pre-membership: walkthrough / activation occupy the full shell with no tabbar. */
.app-premember .tabbar {
  display: none !important;
}

.app-premember .first-run-standalone {
  position: relative;
  min-height: 100dvh;
}

.first-run-dots {
  display: flex;
  gap: 8px;
}

.first-run-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  transition: width var(--motion), background var(--motion), box-shadow var(--motion);
}

.first-run-dot.active {
  width: 22px;
  border-radius: 999px;
  background: var(--accent);
  box-shadow: 0 0 12px rgba(94, 214, 232, 0.5);
}

.first-run-dot.done {
  background: rgba(94, 214, 232, 0.4);
}

.first-run-cta {
  width: 100%;
  max-width: 320px;
}

/* Join (final) CTA escalation  -  Claude Pass A SHIP; Continue unchanged */
.first-run-cta[data-final=\"true\"] {
  min-height: 52px;
  max-width: 100%;
  font-size: 1rem;
  letter-spacing: 0.01em;
}

.first-run-top-spacer {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
}

/* Onboarding scenes */
.scene {
  min-height: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  position: relative;
}

.scene-welcome {
  min-height: 180px;
}

.scene-brand-arrival {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160px;
  width: 100%;
}

.scene-orbit {
  position: absolute;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 1px solid rgba(94, 214, 232, 0.2);
  box-shadow: 0 0 40px rgba(94, 214, 232, 0.12);
  left: 50%;
  top: 50%;
  margin-left: -60px;
  margin-top: -72px;
  pointer-events: none;
}

.scene-calm-ring {
  position: absolute;
  width: 96px;
  height: 96px;
  border-radius: 50%;
  border: 1px solid rgba(139, 156, 255, 0.25);
  box-shadow: 0 0 32px rgba(139, 156, 255, 0.15);
}

.scene-chat {
  width: 100%;
  align-items: stretch;
  gap: 8px;
  padding: 8px 4px;
}

.scene-bubble {
  max-width: 92%;
  padding: 10px 14px;
  border-radius: 18px;
  font-size: 0.9rem;
  line-height: 1.35;
}

.scene-bubble.out {
  align-self: flex-end;
  background: linear-gradient(145deg, #1f5568, #1a4a5c);
  box-shadow: 0 0 20px rgba(94, 214, 232, 0.2);
  border-bottom-right-radius: 6px;
}

.scene-bubble.in {
  align-self: flex-start;
  background: var(--bubble-in);
  border: 1px solid var(--border);
  border-bottom-left-radius: 6px;
}

.scene-chip {
  align-self: center;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid rgba(94, 214, 232, 0.35);
  background: rgba(94, 214, 232, 0.12);
  color: var(--accent-soft);
}

.scene-chip.gold {
  border-color: rgba(212, 180, 131, 0.4);
  background: rgba(212, 180, 131, 0.12);
  color: var(--pearl);
}

.scene-chip.ready {
  border-color: rgba(62, 207, 154, 0.4);
  background: rgba(62, 207, 154, 0.12);
  color: #7eecc0;
}

/*  -  -  Social Flow 18: people you know  -  -  */
.find-people-overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: grid;
  place-items: end center;
  background: rgba(3, 4, 8, 0.72);
  padding: 12px;
}

.find-people-sheet {
  width: min(440px, 100%);
  max-height: min(88dvh, 720px);
  overflow: auto;
  padding: 18px 16px 20px;
  border-radius: 20px 20px 16px 16px;
}

.find-people-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.find-people-header h2 {
  margin: 0;
  font-size: 1.15rem;
}

.find-people-body .field {
  display: grid;
  gap: 6px;
  margin-bottom: 12px;
}

.find-people-body .field input {
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  color: inherit;
  padding: 12px 14px;
}

.find-people-actions {
  display: grid;
  gap: 10px;
  margin-top: 14px;
}

.find-people-actions.compact {
  margin: 8px 0 12px;
}

.permission-line {
  font-size: 0.92rem;
  color: rgba(230, 240, 255, 0.78);
  line-height: 1.45;
}

.selected-people {
  list-style: none;
  margin: 12px 0 0;
  padding: 0;
  display: grid;
  gap: 8px;
}

.selected-people li {
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.share-box {
  margin-top: 12px;
  display: grid;
  gap: 10px;
}

.share-url {
  display: block;
  font-size: 0.78rem;
  word-break: break-all;
  padding: 10px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.35);
}

.empty-people {
  padding: 24px 8px 12px;
  text-align: center;
}

.empty-title {
  font-size: 1.05rem;
  margin: 0 0 8px;
  color: rgba(240, 248, 255, 0.95);
}

/*  -  -  Reduced motion  -  -  */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .opal-mark--glow {
    filter: none;
  }
}

/* Phone: Opal IS the surface — no 390 letterbox card in Safari/Brave. */
@media (max-width: 519px) {
  .app,
  .app-premember,
  .app-first-run-splash {
    max-width: none;
    width: 100%;
    margin: 0;
    overflow-x: hidden;
  }
}

/* Desktop breathing room — centered stage */
@media (min-width: 520px) {
  .app {
    max-width: 390px;
    box-shadow: 0 0 80px rgba(94, 214, 232, 0.06), 0 24px 80px rgba(0, 0, 0, 0.55);
    border-radius: 24px;
    margin-block: 12px;
    min-height: calc(100dvh - 24px);
    height: calc(100dvh - 24px);
  }

  body {
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(94, 214, 232, 0.07), transparent),
      #030408;
  }
}

/* ═══════════════════════════════════════════════════════════
   V2.0 Living Void  -  coded experience closure (additive layer)
   Humans occupy space. Opal changes space. No logo halo.
   ═══════════════════════════════════════════════════════════ */

.home-living-field {
  padding-bottom: 24px;
}

/* Figma V2 HOME (2:2): 390 frame, editorial at ~72, presence 346×~84–108, 22px side inset */
.home-editorial {
  margin: 8px 0 4px;
  padding: 0 2px;
  font-size: 1.85rem;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.12;
  color: var(--text);
  max-width: 18ch;
}

.home-lede {
  margin: 0 0 24px;
  font-size: 0.88rem;
  color: var(--muted);
  max-width: 28ch;
}

.presence-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.presence-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  width: 100%;
  min-height: 84px;
  text-align: left;
  padding: 18px 16px 16px 16px;
  border: 1px solid transparent;
  border-radius: 20px;
  background:
    radial-gradient(120% 80% at 12% 0%, rgba(110, 231, 245, 0.07), transparent 55%),
    var(--surface);
  color: var(--text);
  box-shadow:
    0 20px 44px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
  transition: border-color var(--motion), transform var(--motion);
}

/* Group: still a presence block  -  not attendance matrix */
.presence-block[data-composition=\"group\"] {
  border-color: rgba(110, 231, 245, 0.16);
}

/* AWAKENING decide strip (Figma 2:7)  -  one decision, left material edge */
.presence-block.is-awakening,
.home-living-field .needs-you-card,
.home-living-field [data-ui-job=\"resolve\"] {
  position: relative;
  padding-left: 22px;
}
.presence-block.is-awakening::before,
.home-living-field .needs-you-card::before {
  content: \"\";
  position: absolute;
  left: 12px;
  top: 18px;
  bottom: 18px;
  width: 3px;
  border-radius: 2px;
  background: var(--accent);
  opacity: 0.85;
}

.presence-block:active {
  transform: scale(0.99);
}

.presence-block.awaken {
  border-color: rgba(110, 231, 245, 0.35);
  background:
    linear-gradient(105deg, rgba(110, 231, 245, 0.08), transparent 55%),
    var(--surface-raised);
  box-shadow:
    inset 3px 0 0 var(--accent),
    0 18px 40px rgba(0, 0, 0, 0.28);
}

.presence-block.settled {
  border-color: rgba(61, 223, 154, 0.28);
  box-shadow:
    inset 3px 0 0 var(--resolve),
    0 18px 40px rgba(0, 0, 0, 0.28);
}

.presence-block.calm {
  opacity: 0.96;
}

.presence-block.subtle {
  opacity: 0.88;
}

.presence-kicker {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}

.presence-who {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
}

.presence-title {
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.presence-detail {
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.35;
}

.presence-gap {
  margin-top: 4px;
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--accent-soft);
}

.next-together-strip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  width: 100%;
  padding: 10px 16px;
  border: none;
  border-bottom: 1px solid var(--border);
  background: rgba(110, 231, 245, 0.04);
  text-align: left;
  color: var(--text);
}

.next-together-kicker {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
}

.next-together-line {
  font-size: 0.88rem;
  font-weight: 500;
}

.journey-cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 12px 0;
}

.btn.journey-cta {
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 0.82rem;
  border: 1px solid var(--border-bright);
  background: rgba(110, 231, 245, 0.08);
  color: var(--accent-soft);
}

/* Mild shrink for Find a time cyan — keep ≥44px touch without redesign */
.btn.journey-cta.journey-cta-find-time,
.btn.journey-cta[data-gap=\"time\"] {
  padding: 8px 12px;
  font-size: 0.78rem;
  min-height: 44px;
  box-shadow: none;
  background: rgba(110, 231, 245, 0.05);
}

.btn.journey-cta.ghost {
  background: transparent;
  color: var(--muted);
}

.curate-panel,
.extend-panel {
  margin: 8px 12px;
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid rgba(139, 124, 255, 0.28);
  background:
    linear-gradient(160deg, rgba(139, 124, 255, 0.1), transparent 50%),
    var(--surface-raised);
}

.curate-kicker {
  margin: 0 0 4px;
  font-size: 1rem;
  font-weight: 600;
}

.curate-authorship {
  margin: 0 0 10px;
  font-size: 0.78rem;
  color: var(--private);
}

.curate-list {
  margin: 0 0 10px;
  padding-left: 1.1rem;
  color: var(--text);
  font-size: 0.9rem;
  line-height: 1.55;
}

.curate-truth {
  margin: 0 0 12px;
  font-size: 0.75rem;
  color: var(--muted);
}

/* Opal filament  -  smaller than human bubbles, chronological material */
.opal-moment.inline {
  max-width: 88%;
  margin: 6px 12px;
  padding: 8px 12px;
  border-radius: 12px;
  border-left: 2px solid var(--accent);
  background: rgba(110, 231, 245, 0.06);
  font-size: 0.82rem;
  color: var(--accent-soft);
}

.opal-moment.inline .opal-moment-mark {
  color: var(--accent);
  opacity: 0.85;
}

@media (prefers-reduced-motion: reduce) {
  .presence-block,
  .next-together-strip,
  .opal-moment {
    transition: none !important;
    animation: none !important;
  }
}

/* ── Founder repair + intelligence visibility ── */

.connection-hint-sustained {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 2px;
}

.session-pill-warn {
  border-color: rgba(232, 90, 90, 0.35);
  color: #f0a0a0;
  background: rgba(232, 90, 90, 0.08);
}

/* Figma CHAT filament (3:11): inset ~35, 2–4px left bar, not AI card / not peer bubble */
.opal-moment.filament {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-width: 82%;
  margin: 10px 20px 10px 35px;
  padding: 8px 12px 8px 14px;
  border-radius: 2px;
  border: none;
  border-left: 2px solid var(--accent);
  background: transparent;
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.005em;
  line-height: 1.35;
  color: var(--accent-soft);
  opacity: 0.92;
  box-shadow: none;
}

.opal-moment.filament.signal-set,
.opal-moment.filament.signal-ready {
  border-left-width: 4px;
  color: var(--text);
  opacity: 0.95;
}

.opal-moment.filament.is-private {
  margin-left: 22px;
  margin-right: 22px;
  max-width: calc(100% - 44px);
  padding: 14px 16px;
  border-radius: 16px;
  border-left: none;
  background: rgba(139, 124, 255, 0.12);
  color: #d4cbff;
  box-shadow: inset 0 0 0 1px rgba(139, 124, 255, 0.2);
}

/* Figma SHARED REALITY (4:2): settled plate under atmosphere  -  not a possibility card */
.shared-reality-plate,
.opal-resolution,
[data-testid=\"shared-reality\"],
[data-testid=\"opal-resolution\"] {
  position: relative;
  overflow: hidden;
  border-radius: 24px 24px 20px 20px;
  background:
    radial-gradient(90% 70% at 50% -10%, rgba(110, 231, 245, 0.14), transparent 55%),
    linear-gradient(180deg, rgba(8, 12, 18, 0.35) 0%, var(--surface-raised) 48%),
    var(--surface-raised);
  box-shadow:
    0 32px 64px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(138, 150, 168, 0.12);
  padding: 22px 20px 24px;
}

.opal-resolution-ambient {
  position: absolute;
  inset: -20% -10% auto;
  height: 55%;
  background: radial-gradient(ellipse at 50% 0%, rgba(110, 231, 245, 0.16), transparent 70%);
  pointer-events: none;
}

.opal-resolution-core {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.opal-resolution-label {
  font-size: 1.28rem;
  font-weight: 650;
  letter-spacing: -0.025em;
  line-height: 1.2;
  color: var(--text);
}

.opal-resolution-mark {
  color: var(--accent);
  opacity: 0.75;
  font-size: 0.85rem;
}

/* Figma CURATE (4:11): composition field  -  soft concentric calm, not chrome panel */
.curate-panel,
[data-testid=\"curate-panel\"],
.extend-panel {
  border-radius: 24px;
  padding: 28px 22px 24px;
  background:
    radial-gradient(circle at 50% 28%, rgba(110, 231, 245, 0.1) 0%, transparent 42%),
    radial-gradient(circle at 50% 30%, rgba(139, 124, 255, 0.06) 0%, transparent 55%),
    var(--surface);
  border: 1px solid rgba(138, 150, 168, 0.1);
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
}

.curate-panel h2,
.extend-panel h2 {
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  max-width: 14ch;
}

.opal-moment-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.85;
}

.opal-moment.filament.is-private .opal-moment-who {
  color: var(--private);
}

.extend-options {
  list-style: none;
  margin: 0 0 12px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.extend-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: rgba(3, 5, 8, 0.45);
  color: var(--text);
}

.extend-option:hover {
  border-color: var(--border-bright);
}

.profile-pane .profile-meta {
  margin: 2px 0 0;
  font-size: 0.85rem;
  color: var(--muted);
}

.profile-hint {
  margin: 8px 4px 0;
  font-size: 0.78rem;
  color: var(--muted);
  line-height: 1.4;
}

.settings-row.static {
  cursor: default;
  opacity: 0.95;
}

.opal-wordmark {
  font-weight: 700;
  letter-spacing: 0.14em;
  font-size: 0.95rem;
}

/* ═══════════════════════════════════════════════════════════
   FIGMA V2.0 EXACT EXTRACTION PASS (2:2 / 3:2 / 4:2 / 4:11)
   Domain truth controls content. Figma controls presentation.
   ═══════════════════════════════════════════════════════════ */

.home-living-field {
  position: relative;
  padding: 0 0 28px;
  /* Figma 844 is a design viewport  -  NOT a content height lock.
     Home field must scroll when presence exceeds the viewport. */
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
}

.home-ambient-field {
  position: absolute;
  left: -40px;
  top: -80px;
  width: 480px;
  height: 360px;
  background:
    radial-gradient(ellipse 70% 60% at 40% 45%, rgba(110, 232, 245, 0.1), transparent 70%),
    radial-gradient(ellipse 50% 45% at 70% 40%, rgba(139, 124, 255, 0.07), transparent 65%),
    radial-gradient(ellipse 40% 35% at 30% 70%, rgba(232, 214, 196, 0.04), transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.home-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 22px 22px 0;
}

.home-opal-mark {
  width: 26px;
  height: 26px;
  display: block;
}

.home-brand-word {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: var(--text);
}

.home-editorial {
  position: relative;
  z-index: 1;
  margin: 24px 22px 20px;
  padding: 0;
  font-size: 34px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.08;
  color: var(--text);
  max-width: 12ch;
}

.home-editorial-line {
  display: block;
}

.home-awaken-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  width: calc(100% - 44px);
  margin: 0 22px 16px;
  min-height: 92px;
  padding: 16px 18px 16px 28px;
  text-align: left;
  border-radius: 24px;
  border: 1px solid rgba(110, 232, 245, 0.7);
  background: #070a10;
  color: var(--text);
}

.home-awaken-bar {
  position: absolute;
  left: 13px;
  top: 17px;
  width: 3px;
  height: 56px;
  border-radius: 2px;
  background: var(--color-signal);
}

.home-awaken-kicker {
  font-size: 11px;
  font-weight: 500;
  color: var(--color-signal);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.home-awaken-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

.home-awaken-meta {
  font-size: 12px;
  color: var(--muted);
}

.presence-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 0 22px;
  margin-top: 4px;
}

.presence-block {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-height: 84px;
  text-align: left;
  padding: 16px;
  border: none;
  border-radius: 22px;
  background: rgba(7, 10, 16, 0.92);
  color: var(--text);
  box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.35);
}

.presence-avatar {
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 1rem;
  background: linear-gradient(145deg, #1a2433, #0c121c);
  color: var(--accent-soft);
  border: 1px solid rgba(138, 150, 168, 0.18);
}

.presence-block.energy-settled .presence-avatar {
  width: 52px;
  height: 52px;
  flex-basis: 52px;
}

.presence-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.presence-who {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

.presence-title {
  font-size: 14px;
  font-weight: 500;
}

.presence-title.tone-settled {
  color: #3dde99;
}

.presence-title.tone-possibility,
.presence-title.tone-awaken {
  color: var(--color-signal);
}

.presence-title.tone-recall {
  color: #8b7cff;
}

.presence-title.tone-calm {
  color: var(--pearl);
}

.presence-detail {
  font-size: 12px;
  color: var(--muted);
}

.presence-gap {
  font-size: 12px;
  color: var(--muted);
}

/* Chat header Figma 3:2  -  68px, reality context */
.chat-header {
  height: 68px;
  min-height: 68px;
  background: rgba(3, 4, 6, 0.9);
  border-bottom: 1px solid transparent;
  gap: 12px;
  padding: 0 16px;
}

.chat-header-name {
  font-size: 16px;
  font-weight: 600;
}

.chat-header-sub {
  font-size: 11px;
  color: var(--muted);
  opacity: 1;
}

/* Keep flex scroll behavior from base .thread  -  only palette/gap here */
.thread {
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(110, 232, 245, 0.06), transparent 60%),
    radial-gradient(ellipse 40% 30% at 90% 80%, rgba(139, 124, 255, 0.05), transparent 55%),
    #030406;
  gap: 10px;
  padding: 16px 16px 12px;
}

/* Human bubbles Figma 3:8 / 3:15 — text wraps; never clip top/bottom of copy. */
.bubble {
  max-width: 260px;
  padding: 12px 14px 10px;
  font-size: 15px;
  line-height: 1.45;
  overflow: visible;
  box-sizing: border-box;
  word-break: break-word;
  overflow-wrap: anywhere;
  height: auto;
  min-height: 0;
}

.bubble time {
  font-size: 10px;
  opacity: 0.75;
}

.bubble.in {
  background: #12171f;
  border: none;
  border-radius: 6px 18px 18px 18px;
}

.bubble.out {
  background: #143847;
  color: #f4f7fa;
  border-radius: 18px 6px 18px 18px;
  box-shadow: none;
}

/* Filament Figma 3:11 / 3:21  -  bar + copy, not a card */
.opal-moment.filament {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12px;
  max-width: 320px;
  margin: 4px 0 4px 19px;
  padding: 8px 0;
  border: none;
  border-left: none;
  background: transparent;
  color: var(--text);
  opacity: 1;
}

.opal-moment.filament .filament-bar {
  flex: 0 0 2px;
  width: 2px;
  min-height: 28px;
  margin-top: 2px;
  border-radius: 2px;
  background: var(--color-motion);
}

/* Set completion keeps emerald; Ready/confirmed uses Signal Grammar gold */
.opal-moment.filament.signal-set .filament-bar {
  width: 4px;
  flex-basis: 4px;
  min-height: 36px;
  background: #3dde99;
  box-shadow: 0 0 12px rgba(61, 222, 153, 0.55);
}
.opal-moment.filament.signal-ready .filament-bar {
  width: 4px;
  flex-basis: 4px;
  min-height: 36px;
  background: var(--signal-confirmed);
  box-shadow: 0 0 12px color-mix(in srgb, var(--signal-confirmed) 55%, transparent);
}

.opal-moment.filament .filament-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.opal-moment.filament .opal-moment-label {
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
}

.opal-moment.filament.signal-set .opal-moment-label,
.opal-moment.filament.signal-ready .opal-moment-label {
  font-size: 14px;
  font-weight: 600;
}

.opal-moment.filament time {
  font-size: 10px;
  color: var(--muted);
}

.opal-moment.filament[data-call-outcome=\"missed\"] .opal-moment-label {
  color: #ff6b9d;
}

/* Private Opal Figma 3:29 */
.private-opal-plate {
  margin: 8px 22px;
  padding: 14px 16px 16px;
  border-radius: 20px;
  border: 1px solid rgba(139, 124, 255, 0.45);
  background: linear-gradient(180deg, rgba(26, 18, 51, 0.95), rgba(10, 8, 20, 0.98));
  max-width: 346px;
}

.private-opal-kicker {
  margin: 0 0 10px;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #8b7cff;
}

.private-opal-body {
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
  color: var(--text);
}

.private-opal-time {
  display: block;
  margin-top: 8px;
  font-size: 10px;
  color: var(--muted);
}

.extend-panel.private-opal-plate {
  margin: 8px 12px 4px;
  max-width: none;
}

/* ── Shared Reality signature object (Figma 4:2) exact structure ── */
.shared-reality-plate.sr-signature,
