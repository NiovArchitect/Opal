"PHYSICAL IPHONE LAYOUT SYSTEM (2026-09-10) — CORRECTION #2
   Figma owns composition. Runtime owns responsive geometry.
   Native host only. Does not reopen 390 desktop stage.
   SAFE_AREA_OWNER = WEB · BOTTOM_NAV_OWNER = .tabbar.tabbar-option-b
   PRIMARY_SCROLL_VIEWPORT clips ABOVE dock (not padding-under-scroll).
   Mandatory viewports: 375×812 · 390×844 · 393×852 · 430×932
   ═══════════════════════════════════════════════════════════ */
html.opal-native-host {
  --opal-safe-top: env(safe-area-inset-top, 0px);
  --opal-safe-bottom: env(safe-area-inset-bottom, 0px);
  /*
   * FOUNDER DIRECTION COMPACT FLOATING CHROME 1114:2 (live Figma 2026-09-10):
   * At 390: sides 10 · w370 · outer h74 · field y10 h60 r26 · Opal 86×64 @ 142,0.
   * FLOATS ABOVE safe-bottom + --opal-dock-lift (~2). Do NOT bake safe-bottom into height.
   * Pill settles near the safe area; Center Opal may protrude upward independently
   * (bar-top overhang). Do NOT raise the whole dock to accommodate the orb.
   * Prior 92pt+safe slab physically rejected. Frost + spectral edge + labels retained.
   * Ambient may continue behind frost; meaningful content may NOT (CONTENT_BEHIND_DOCK=0).
   * Center 1094:161 content UNCHANGED by this chrome pass.
   */
  --opal-dock-side-margin: 10px;
  --opal-dock-base-height: 74px;
  --opal-dock-bar-top: 10px;
  --opal-dock-bar-height: 60px;
  --opal-dock-icon-top: 22px;
  --opal-dock-label-top: 47px;
  --opal-center-opal-top: 8px;
  --opal-center-opal-width: 86px;
  --opal-center-opal-height: 64px;
  --opal-dock-figma-width: 370;
  --opal-dock-field-radius: 26px;
  --opal-dock-field-fill: rgba(8, 13, 30, 0.94);
  /* Pill sits on safe-area bottom; Center Opal protrudes independently above frost. */
  --opal-dock-lift: 0px;
  /* Soft fade zone above dock (illusion of emerging behind frost) */
  --opal-dock-content-gap: 6px;
  --opal-scroll-trail-pad: 10px;
  --dock-overlap: var(--opal-dock-base-height);
  --dock-offset: 0px;
  --dock-breath: 0px;
  /*
   * DOCK_EXCLUSION_DOUBLE_COUNT = 0
   * Physical bottom → content clip:
   *   safe-bottom + lift + compact 74 + gap
   * Dock HEIGHT itself stays 74 — never 74+safe.
   */
  --opal-primary-viewport-inset: calc(
    var(--opal-dock-base-height) + var(--opal-dock-lift) + var(--opal-safe-bottom) +
      var(--opal-dock-content-gap)
  );
  --dock-clearance: var(--opal-primary-viewport-inset);
}

/*
 * TRUE PRIMARY CONTENT VIEWPORT
 * Shell reserves the dock exclusion zone. Flex children cannot paint there.
 * Absolute dock sits in that reserved region. Scrollports fill the pane above.
 * CONTENT_VISIBLE_BEHIND_NAV = 0 at every scroll position (not only at scroll end).
 */
html.opal-native-host .app[data-member-nav=\"true\"] {
  padding-bottom: var(--opal-primary-viewport-inset) !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
}
/*
 * WALK-FAIL-02: structured conversation uses absolute chrome (not grid+absolute mix).
 * Shell padding-bottom would reserve a second dock band → mid-screen dock + dead zone.
 * DOCK_EXCLUSION_DOUBLE_COUNT = 0
 */
html.opal-native-host .app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] {
  padding-bottom: 0 !important;
  height: 100% !important;
  max-height: 100% !important;
}
