.live-call {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100dvh;
  max-height: 100dvh;
  overflow: hidden;
  padding:
    calc(16px + env(safe-area-inset-top, 0px))
    20px
    calc(16px + env(safe-area-inset-bottom, 0px));
  background: #070b14;
  color: #f4f7fa;
}

.live-call-stage {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.live-call-status {
  margin: 8px 0 0;
  font-size: 15px;
  letter-spacing: 0.02em;
  color: #9ff3ea;
}

.live-call-name {
  margin: 12px 0 0;
  font-size: 28px;
  line-height: 1.15;
}

.live-call-mark {
  flex: 0 0 auto;
  width: 112px;
  height: 112px;
  aspect-ratio: 1;
  margin: 28px auto 0;
  border-radius: 50%;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: #142033;
  font-size: 42px;
}

.live-call-mark img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.live-call-timer {
  flex: 0 0 auto;
  margin: 28px 0 0;
  font-size: 40px;
  font-variant-numeric: tabular-nums;
}

.live-call-note {
  margin: 16px 0 0;
  color: #f0c7c7;
  font-size: 14px;
}

.live-call-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  width: min(100%, 360px);
  margin-top: auto;
}

.live-call-actions button {
  flex: 1 1 0;
  height: 56px;
  border: 0;
  border-radius: 16px;
  font: inherit;
  font-size: 17px;
  font-weight: 650;
}

.live-call-assist {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  margin: 16px 0 8px;
}

.live-call-assist-kicker {
  margin: 0;
  color: rgba(244, 247, 250, 0.72);
  font-size: 13px;
}

.live-call-assist button {
  border: 1px solid rgba(255, 200, 107, 0.45);
  background: transparent;
  color: #ffc86b;
  border-radius: 999px;
  padding: 8px 14px;
  font: inherit;
}

.live-call-assist-note {
  margin: 0;
  color: rgba(244, 247, 250, 0.72);
  font-size: 12px;
}

@media (min-width: 840px) {
  .live-call {
    align-items: center;
    justify-content: center;
    background: #05080f;
  }

  .live-call-stage {
    flex: 0 1 auto;
    width: min(420px, calc(100vw - 64px));
    max-height: min(680px, calc(100dvh - 64px));
    min-height: 520px;
    padding: 36px 28px 28px;
    border-radius: 28px;
    background: #070b14;
    border: 1px solid rgba(244, 247, 250, 0.08);
  }

  .live-call-actions {
    margin-top: 36px;
  }

  .live-call-actions button {
    flex: 0 1 168px;
  }
}

.live-call-decline,
.live-call-end {
  background: #3a2430;
  color: #ffd7df;
}

.live-call-accept {
  background: #1c4a3a;
  color: #d9fff0;
}

/* ═══════════════════════════════════════════════════════════
   Mobile product shell — authenticated destinations (A8 HOLD)
   FIXED_844_STAGE_AS_APP_SHELL = 0 for primary member surfaces.
   Phone physical viewport is the app; 844 remains a test reference only.
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 519px) {
  .app[data-member-nav=\"true\"] .gsh.scroll,
  .gsh.scroll {
    width: 100% !important;
    max-width: none !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    min-height: 0 !important;
  }

  .gsh,
  .gsh-top,
  .gsh-top-spectral,
  .graphs-home,
  .chats-home,
  .opal-ambient {
    width: 100% !important;
    max-width: none !important;
  }

  .gsh-top,
  .gsh-top-spectral {
    width: 100% !important;
    max-width: none !important;
    padding-top: env(safe-area-inset-top, 0px);
  }

  .profile-person-overlay,
  .gprof,
  .gprof-mem-grid,
  .opal-ambient-destination,
  .opal-ambient-overlay,
  .graph-create-flow,
  .graph-create-choose,
  .graph-create-compose,
  .full-live-863,
  .profile-pane.you-pane-nested,
  .you-pane-nested,
  .group-info-dest,
  .call-continuity-dest,
  .new-call-dest,
  .search-dest-373-261,
  .activity-dest-473-141,
  .ogsn-graph-detail.social-dest-373-385 {
    width: 100% !important;
    max-width: none !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    min-height: 0 !important;
  }

  /* Full-bleed overlays still clear home indicator when scrolled */
  .activity-dest-473-141,
  .ogsn-graph-detail.social-dest-373-385,
  .search-dest-373-261 {
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
}


/* COHERENCE: graph status pill must stay in viewport */
.graphs-card-top {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.graphs-card-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.graphs-card-status,
.social-dest-373-385 .graph-ready-pill {
  flex-shrink: 1;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
@media (max-width: 519px) {
  .graphs-card,
  .social-dest-373-385 .graph-card {
    max-width: 100%;
    overflow-x: hidden;
  }
}


/* Phase 4D — Graphs Trips strip (reuse graph-card chrome; C-01 / B-04 intact) */
.you-settings-spending {
