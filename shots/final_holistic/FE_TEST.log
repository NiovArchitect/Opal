}

.opal-wordmark-raster {
  object-fit: contain;
  display: block;
  height: auto;
  max-width: 100%;
}

.scene-welcome .scene-brand-arrival {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Responsive: Figma 390 reference; nearby phone widths */
@media (max-width: 430px) {
