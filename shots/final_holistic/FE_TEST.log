/* ═══════════════════════════════════════════════════════════
   Phase OC-1 — Opal Center conversational shell
   Reuses bubble-row / opal-center-v2-composer / C-01 / B-04.
   Layout only — no new palette, type, or motion system.
   ═══════════════════════════════════════════════════════════ */
.opal-center-chat {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  height: 100%;
}
.opal-center-chat-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: calc(14px + env(safe-area-inset-top, 0px)) 12px 10px;
}
.opal-center-chat-title {
  margin: 0;
  flex: 1 1 auto;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #f8faff;
  letter-spacing: -0.01em;
}
.opal-center-chat-header-spacer {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
}
.opal-center-chat-header .opal-nav-chevron {
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
}
.opal-center-chat-voice-toggle {
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 19px;
  display: grid;
  place-items: center;
  padding: 0;
  cursor: pointer;
  background: rgba(148, 161, 184, 0.12);
  color: #94a1b8;
  transition: color 0.15s ease, background 0.15s ease;
}
.opal-center-chat-voice-toggle.is-on {
  background: rgba(0, 229, 255, 0.14);
  color: #00e5ff;
}
.opal-center-chat-voice-hint {
  flex: 0 0 auto;
  margin: 0 12px 6px;
  padding: 8px 12px;
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.35;
  color: #f8faff;
  background: rgba(255, 138, 138, 0.14);
  border: 1px solid rgba(255, 138, 138, 0.28);
}
.opal-center-chat-thread {
  flex: 1 1 auto;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 8px 12px 12px;
}
.opal-center-chat-empty {
  margin: auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
  padding: 24px 8px;
}
.opal-center-chat-empty-copy {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: #f8faff;
}
.opal-center-chat-error {
  margin: auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
  color: #c9d2e0;
  font-size: 14px;
}
.opal-center-chat-opal-avatar {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  color: #00e5ff;
}
.opal-center-chat-mark {
  display: block;
}
.opal-center-chat-send-error {
  border: 0;
  background: transparent;
  color: #ff8a8a;
  font: inherit;
  font-size: 12px;
  padding: 4px 2px;
  cursor: pointer;
  text-align: left;
}
.opal-center-chat-composer {
  flex: 0 0 auto;
  align-items: flex-end;
  min-height: 54px;
  height: auto !important;
  gap: 8px;
}
.opal-center-chat-composer.is-listening .opal-center-chat-input {
  color: #ff8a8a;
}
.opal-center-chat-mic {
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 20px;
  display: grid;
  place-items: center;
  cursor: pointer;
  padding: 0;
  background: rgba(0, 229, 255, 0.12);
  color: #00e5ff;
  border: 1px solid rgba(0, 229, 255, 0.45);
}
.opal-center-chat-mic.is-recording {
  background: rgba(255, 70, 70, 0.18);
  border-color: rgba(255, 70, 70, 0.55);
  color: #ff6b6b;
}
.opal-center-chat-mic.is-disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.opal-center-chat-mic-pulse {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
}
.opal-center-chat-mic-pulse i {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ff3b3b;
  display: block;
  animation: opal-center-chat-mic-pulse 1s ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(255, 59, 59, 0.45);
}
@keyframes opal-center-chat-mic-pulse {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.92);
    box-shadow: 0 0 0 0 rgba(255, 59, 59, 0.35);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
    box-shadow: 0 0 0 6px rgba(255, 59, 59, 0);
  }
}
.opal-center-chat-input {
  resize: none;
  overflow-y: auto;
  line-height: 20px;
  max-height: 100px;
  height: 36px;
  padding-top: 8px;
  padding-bottom: 8px;
  font-size: 16px; /* prevent iOS auto-zoom */
}
.opal-center-chat-skeleton {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 8px;
}
.opal-center-chat-skel-bubble {
  min-width: 120px;
  min-height: 36px;
  opacity: 0.35;
}
.opal-center-chat-skel-bubble.is-short {
  min-width: 72px;
}
.opal-center-chat-typing-bubble {
  min-width: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.opal-center-chat-typing-dots {
  display: inline-flex;
  gap: 4px;
  align-items: center;
  height: 16px;
}
.opal-center-chat-typing-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #8993a3;
  display: block;
  animation: opal-center-chat-pulse 1.1s ease-in-out infinite;
}
.opal-center-chat-typing-dots i:nth-child(2) { animation-delay: 0.15s; }
.opal-center-chat-typing-dots i:nth-child(3) { animation-delay: 0.3s; }
@keyframes opal-center-chat-pulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}
html.opal-native-host .opal-center-chat-header {
  padding-top: calc(14px + var(--opal-safe-top));
}
html.opal-native-host .opal-center-chat-input {
  font-size: 16px;
}

/* Honest blocker pill — muted, smaller, clearly unavailable (not broken). */
.you-settings-coming-soon,
.you-settings-blocked {
  flex: 0 0 100%;
  order: 3;
  margin-top: 8px;
  margin-right: 56px;
  display: block;
  width: auto;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.01em;
  line-height: 1.35;
  color: rgba(148, 161, 184, 0.92);
  background: rgba(148, 161, 184, 0.1);
  border: 1px solid rgba(148, 161, 184, 0.22);
  border-radius: 999px;
  padding: 4px 9px;
  max-width: 100%;
  text-align: left;
  flex: 1 1 100%;
  margin: 0 0 2px;
  overflow-wrap: anywhere;
}
.you-settings-row > .you-settings-blocked {
  order: 3;
  margin-top: 2px;
  margin-right: -52px; /* reclaim toggle column for long blocker copy */
}
.you-settings-row-blocked {
  padding-right: 12px;
}
.you-settings-row-blocked > .you-settings-blocked {
  margin-right: 0;
}
.you-settings-why {
  margin: 0;
}
.you-settings-why > summary {
  list-style: none;
  cursor: pointer;
  font-size: 12px;
  color: rgba(148, 161, 184, 0.9);
  line-height: 1.35;
}
.you-settings-why > summary::-webkit-details-marker {
  display: none;
}
.you-settings-why > summary::after {
  content: \" ›\";
  opacity: 0.7;
}
.you-settings-why[open] > summary::after {
  content: \" ˄\";
}
.you-settings-why > p {
  margin: 6px 0 0;
  font-size: 12px;
  line-height: 1.4;
  color: rgba(226, 232, 240, 0.66);
}
.you-settings-field .you-settings-blocked {
  flex: 0 0 100%;
  order: 3;
  margin-top: 8px;
  margin-right: 56px;
  display: block;
  width: auto;
  margin-left: 8px;
  margin-right: 0;
  max-width: none;
  text-align: left;
  vertical-align: middle;
  flex: 0 1 auto;
}

/* Save error for profile and settings forms. */
.you-settings-error {
  color: #ff6b9d;
  font-size: 13px;
  margin: 8px 0 0;
  text-align: center;
}

/* Graph convoy + live ETA (Part C) */
.graph-convoy {
  margin: 12px 0 16px;
  padding: 14px;
  border-radius: 18px;
  border: 1px solid #1c2330;
  background: #090b10;
}
.graph-convoy-led-by {
  margin: 0 0 8px;
  font-size: 13px;
  color: #8993a3;
}
.graph-convoy-who {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
.graph-convoy-avatars { display: flex; }
.graph-convoy-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  margin-left: -6px;
  border: 2px solid #090b10;
  display: grid;
  place-items: center;
  font-size: 11px;
  font-weight: 700;
  color: #050816;
  background: #c9d2e0;
}
.graph-convoy-avatar:first-child { margin-left: 0; }
.graph-convoy-going-count {
  font-size: 13px;
  font-weight: 650;
  color: #f4f7fa;
}
.graph-on-the-way {
  width: 100%;
  min-height: 48px;
  border-radius: 14px;
  border: 1px solid rgba(0, 229, 255, 0.45);
  background: color-mix(in srgb, #00e5ff 16%, #050816);
  color: #00e5ff;
  font: inherit;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}
.graph-on-the-way.is-on {
  border-color: rgba(126, 236, 192, 0.55);
  background: color-mix(in srgb, #7eecc0 18%, #050816);
  color: #7eecc0;
  cursor: default;
}
.graph-share-eta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 12px 0;
  font-size: 13px;
  color: #c9d2e0;
  cursor: pointer;
}
.graph-eta-section {
  margin: 12px 0;
  padding-top: 10px;
  border-top: 1px solid #1c2330;
}
.graph-convoy-list ul {
  list-style: none;
  margin: 8px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.graph-convoy-row {
  font-size: 13px;
