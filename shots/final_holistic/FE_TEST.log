    box-sizing: border-box;
  }
  .fr-auth-v4.fr-find .fr-find-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px auto 0;
  }

  .fr-splash-aura {
    top: calc(108px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mark {
    top: calc(128px + env(safe-area-inset-top, 0px));
