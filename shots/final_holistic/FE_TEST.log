  color: var(--accent);
}

.sr-signature .sr-travel {
  margin-top: 4px;
}

.sr-signature .sr-travel-line,
.sr-signature .sr-leave-around {
  margin: 0;
  font-size: 13px;
  line-height: 1.35;
  color: #8a96a8;
}

.presence-title.tone-group,
.presence-block.energy-group .presence-title {
  color: #e8d6c4;
}

/* Opening brand continuity  -  founder full lockup (orbital + OPAL) */
