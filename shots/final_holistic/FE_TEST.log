    radial-gradient(ellipse 80% 90% at 12% 20%, rgba(0, 229, 255, 0.22), transparent 55%),
    radial-gradient(ellipse 70% 80% at 90% 80%, rgba(139, 92, 246, 0.18), transparent 60%),
    linear-gradient(160deg, #0b1226 0%, #050816 100%);
