  .fr-auth-v4 .fr-phone-field {
    top: calc(270px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-phone-hint {
    top: calc(354px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-consent {
    top: calc(400px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-code-wrap {
    top: calc(250px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4.fr-phone .fr-primary,
  .fr-auth-v4.fr-phone .btn.primary.fr-primary,
  .fr-auth-v4.fr-verify .fr-primary,
  .fr-auth-v4.fr-verify .btn.primary.fr-primary {
    top: auto;
    bottom: calc(66px + env(safe-area-inset-bottom, 0px));
  }
  .fr-auth-v4.fr-phone .fr-text-action,
  .fr-auth-v4.fr-phone .fr-skip-for-now,
  .fr-auth-v4.fr-verify .fr-text-action,
  .fr-auth-v4.fr-verify .fr-change-number {
    top: auto;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  }
  .fr-auth-v4 .fr-secondary[data-testid=\"fr07-resend\"] {
    top: auto;
    bottom: calc(132px + env(safe-area-inset-bottom, 0px));
  }
  /*
   * PROFILE / FIND — one scroll owner on phone widths.
   * Cancel fixed-stage absolute field/CTA geometry (Continue-over-username, Assist collisions).
   * PROFILE_CONTINUE_OVERLAPS_USERNAME = 0 · CONTACTS_ASSIST_OVERLAP = 0
   */
  .fr-auth-v4.fr-profile,
  .fr-auth-v4.fr-find {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow-x: hidden;
    overflow-y: auto;
    height: 100dvh;
    min-height: 100dvh;
    padding: calc(12px + env(safe-area-inset-top, 0px)) 24px
      calc(28px + env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
  }
  .fr-auth-v4.fr-profile .fr-auth-header,
  .fr-auth-v4.fr-find .fr-auth-header,
  .fr-auth-v4.fr-profile .fr-title,
  .fr-auth-v4.fr-find .fr-title,
  .fr-auth-v4.fr-profile .fr-body,
  .fr-auth-v4.fr-find .fr-body,
  .fr-auth-v4.fr-profile .fr-form,
  .fr-auth-v4.fr-find .fr-form,
  .fr-auth-v4.fr-profile .fr-profile-photo,
  .fr-auth-v4.fr-profile .fr-profile-ring,
  .fr-auth-v4.fr-profile .fr-add-photo-label,
  .fr-auth-v4.fr-profile label,
  .fr-auth-v4.fr-profile input,
  .fr-auth-v4.fr-profile .fr-primary,
  .fr-auth-v4.fr-profile .fr-meta,
  .fr-auth-v4.fr-find .fr-find-card,
  .fr-auth-v4.fr-find .fr-find-actions,
  .fr-auth-v4.fr-find .fr-find-actions .fr-primary,
  .fr-auth-v4.fr-find .fr-find-actions .btn.primary.fr-primary,
  .fr-auth-v4.fr-find .fr-not-now,
  .fr-auth-v4.fr-find .fr-assist-enable,
  .fr-auth-v4.fr-find .fr-assist-dismiss {
    position: relative;
