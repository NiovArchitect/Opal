/* Phone (fr06) keeps Figma absolute stack but already has safe-area offsets above */


/* ═══════════════════════════════════════════════════════════
   OPAL CENTER V2 — LIFE GRAPH / SOLO-FIRST (1094:161)
   Midnight dominant. Spectral colors as signal. No neural dashboard.
   ═══════════════════════════════════════════════════════════ */
.opal-center-v2 {
  /* In-flow stack: header → scroll → lenses → composer. CENTER_CONTENT_HIDDEN_BY_COMPOSER = 0 */
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 100%;
  max-width: none;
  box-sizing: border-box;
  padding: 0;
  overflow: hidden;
  background: #050816;
  color: #f5f7fc;
}
.opal-center-v2-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0 0 12px;
}
.opal-center-v2-bloom {
  position: absolute;
  inset: 0 0 auto 0;
  height: 280px;
  pointer-events: none;
  background:
    radial-gradient(ellipse 70% 80% at 0% 0%, rgba(0, 229, 255, 0.14), transparent 60%),
    radial-gradient(ellipse 60% 70% at 100% 20%, rgba(217, 70, 255, 0.1), transparent 65%);
}
.opal-center-v2-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  /* P2 — less top chrome so rest content can sit higher */
  padding: calc(10px + env(safe-area-inset-top, 0px)) 20px 4px;
}
.opal-center-v2-wordmark { color: #f8faff; }
.opal-center-v2-refresh {
  position: absolute;
  right: 16px;
  top: calc(14px + env(safe-area-inset-top, 0px));
  width: 38px;
  height: 38px;
  border-radius: 12px;
  border: 1px solid rgba(138, 150, 168, 0.28);
  background: rgba(8, 13, 30, 0.72);
  color: #c9d2e0;
  font-size: 18px;
  cursor: pointer;
}
.opal-center-v2-body {
  position: relative;
  z-index: 1;
  /* B-04 R3: horizontal inset matches Home feed card (12) */
  padding: 8px 12px 24px;
}
.opal-center-v2-kicker {
  margin: 0 0 8px;
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.08em;
  color: #8993a3;
}
.opal-center-v2-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: #f8faff;
}
.opal-center-v2-lede {
  margin: 8px 0 0;
  font-size: 14px;
  color: #9eadc7;
}
.opal-life-graph {
  position: relative;
  margin: 18px 0;
  padding: 22px 12px 16px;
  border-radius: 18px;
  background: rgba(8, 13, 30, 0.72);
  border: 1px solid var(--opal-deep-space, #0B1226);
}
.opal-life-graph-line {
  position: absolute;
  left: 36px;
  right: 36px;
  top: 40px;
  height: 2px;
  background: linear-gradient(90deg, rgba(0, 229, 255, 0.55), rgba(255, 200, 107, 0.45), rgba(217, 70, 255, 0.5));
}
.opal-life-graph-nodes {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}
.opal-life-graph-node {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 6px;
}
.opal-life-graph-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #00e5ff;
  box-shadow: 0 0 10px rgba(0, 229, 255, 0.45);
  z-index: 1;
}
.opal-life-graph-node.is-event .opal-life-graph-dot { background: #ffc86b; box-shadow: 0 0 10px rgba(255, 200, 107, 0.35); }
.opal-life-graph-node.is-accepted .opal-life-graph-dot { background: #d946ff; box-shadow: 0 0 10px rgba(217, 70, 255, 0.4); }
.opal-life-graph-time { font-size: 12px; font-weight: 650; color: #f4f7fa; }
.opal-life-graph-label { font-size: 11px; color: #9eadc7; }
.opal-center-v2-signal {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  margin: 18px 0;
}
.opal-center-v2-signal-orb { flex: 0 0 32px; width: 32px; height: 24px; object-fit: contain; }
.opal-center-v2-signal-primary { margin: 0; font-size: 15px; font-weight: 650; color: #f8faff; }
.opal-center-v2-signal-secondary { margin: 6px 0 0; font-size: 13px; color: #9eadc7; line-height: 1.35; }
.opal-center-v2-quick,
.opal-center-v2-controls,
.opal-center-v2-week-days,
.opal-center-v2-lenses,
.opal-center-v2-answer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 14px 0;
}
.opal-center-v2-chip,
.opal-center-v2-lens,
.opal-center-v2-secondary {
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  border: 1px solid var(--opal-deep-space, #0B1226);
  background: rgba(9, 11, 16, 0.9);
  color: #c9d2e0;
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}
.opal-center-v2-chip.is-active,
.opal-center-v2-lens.is-active {
  border-color: rgba(0, 229, 255, 0.55);
  color: #00e5ff;
}
.opal-center-v2-primary {
  height: 32px;
  padding: 0 14px;
  border-radius: 16px;
  border: 0;
  background: #00e5ff;
  color: #050816;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}
/* OC-1 — Talk to Opal CTA on rest (reuses primary; spacing only). */
.opal-center-talk-to-opal {
  display: block;
  width: 100%;
  max-width: none;
  margin: 14px 0 16px;
  height: 44px;
  font-size: 15px;
  box-sizing: border-box;
}
/* Rest scroll must clear Today/Week/Shared lenses — no cut-off, no overlap */
.opal-center-v2-scroll:has([data-testid=\"opal-center-rest\"]) {
  justify-content: flex-start !important;
  padding-bottom: 12px;
}
[data-testid=\"opal-center-rest\"].opal-center-v2-body {
  padding-bottom: 24px !important;
}
.opal-center-v2-lenses {
  display: flex;
  flex-direction: row;
  gap: 8px;
  justify-content: center;
  flex: 0 0 auto;
  margin: 0 16px 12px;
  padding-top: 4px;
}
/* Center nudges — max 2, dismissable, discovered accent (not sprayed). */
.opal-center-nudges {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 12px 0 4px;
}
.opal-center-nudge {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 36px 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(0, 229, 255, 0.22);
  background: rgba(8, 13, 30, 0.88);
  animation: opal-nudge-enter 320ms ease-out both;
}
.opal-center-nudge.is-gold {
  border-color: rgba(255, 200, 107, 0.45);
  box-shadow: inset 0 0 0 1px rgba(255, 200, 107, 0.08);
}
.opal-center-nudge.is-cyan {
  border-color: rgba(0, 229, 255, 0.35);
}
.opal-center-nudge-body {
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
  color: #f4f7fa;
  overflow-wrap: anywhere;
}
.opal-center-nudge-dismiss {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #8a96a8;
  font-size: 14px;
  cursor: pointer;
}
.opal-center-nudge-dismiss:hover,
.opal-center-nudge-dismiss:focus-visible {
  color: #00e5ff;
}
@keyframes opal-nudge-enter {
  from { opacity: 0; transform: translateY(4px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
/* Dopamine micro-interactions — ease-out only, no spring bounce. */
.gsh-like.is-on,
[data-testid^=\"gsh-like-\"].is-liked {
  animation: opal-like-pop 280ms ease-out both;
}
@keyframes opal-like-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.14); }
  100% { transform: scale(1); }
}
.chats-plan-pill.is-new,
.gsh-card[data-plan-created=\"true\"] {
  animation: opal-plan-appear 360ms ease-out both;
}
@keyframes opal-plan-appear {
  from { opacity: 0; transform: scale(0.97); }
  to { opacity: 1; transform: scale(1); }
}
.you-settings-toggle[aria-checked=\"true\"],
.you-settings-toggle.is-on {
  box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.18);
  transition: box-shadow 280ms ease-out, background 280ms ease-out;
}
.bubble-row {
  animation: opal-bubble-in 260ms ease-out both;
}
@keyframes opal-bubble-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .opal-center-nudge,
  .gsh-like.is-on,
  [data-testid^=\"gsh-like-\"].is-liked,
  .chats-plan-pill.is-new,
  .gsh-card[data-plan-created=\"true\"],
  .bubble-row {
    animation: none !important;
  }
}
.opal-center-v2-footnote { margin: 8px 0 0; font-size: 12px; color: #8993a3; line-height: 1.4; }
.opal-center-v2-context-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0 0 14px;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(8, 13, 30, 0.8);
  border: 1px solid var(--opal-deep-space, #0B1226);
  font-size: 12px;
  color: #9eadc7;
}
.opal-center-v2-context-link {
  border: 0;
  background: transparent;
  color: #00e5ff;
  font: inherit;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}
.opal-center-v2-user-bubble {
  margin: 0 0 16px auto;
  max-width: 270px;
  padding: 12px 14px;
  border-radius: 16px 16px 4px 16px;
  background: rgba(0, 229, 255, 0.12);
  border: 1px solid rgba(0, 229, 255, 0.28);
  color: #e8f7ff;
  font-size: 14px;
  line-height: 1.35;
}
.opal-center-v2-answer,
.opal-center-v2-material {
  margin: 12px 0;
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(8, 13, 30, 0.85);
  border: 1px solid rgba(0, 229, 255, 0.22);
}
.opal-center-v2-answer-kicker {
  margin: 0 0 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #00e5ff;
}
.opal-center-v2-answer-title {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.opal-center-v2-answer-meta { margin: 6px 0 0; font-size: 13px; color: #9eadc7; }
.opal-center-v2-material-line {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: #ffc86b;
}
.opal-center-v2-day-name {
  margin: 16px 0 0;
  font-size: 22px;
  font-weight: 700;
}
.opal-center-v2-vertical {
  list-style: none;
  margin: 18px 0;
  padding: 0 0 0 8px;
  border-left: 2px solid rgba(0, 229, 255, 0.28);
}
.opal-center-v2-vertical li {
  position: relative;
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 8px;
  margin: 0 0 22px;
  padding-left: 18px;
}
.opal-center-v2-dot {
  position: absolute;
  left: -9px;
  top: 4px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #00e5ff;
}
.opal-center-v2-dot.is-shared { background: #8b5cf6; }
.opal-center-v2-vtime { font-size: 12px; color: #8993a3; }
.opal-center-v2-vlabel { font-size: 15px; font-weight: 650; color: #f4f7fa; }
.opal-center-v2-lenses {
  flex: 0 0 auto;
  position: relative;
  z-index: 3;
  margin: 0 16px 8px;
  padding: 0;
}
.opal-center-v2-composer {
  /* In-flow chrome — never absolute over scroll content. */
  position: relative !important;
  left: auto !important;
  transform: none !important;
  bottom: auto !important;
  top: auto !important;
  flex: 0 0 auto;
  width: min(358px, calc(100% - 32px)) !important;
  margin: 0 auto 8px !important;
  z-index: 5;
}
html.opal-native-host .opal-center-v2 {
  padding-bottom: 0 !important;
  height: 100% !important;
  min-height: 0 !important;
}
html.opal-native-host .opal-center-v2-lenses {
  position: relative;
  z-index: 3;
}
.opal-center-v2-provenance {
  list-style: none;
