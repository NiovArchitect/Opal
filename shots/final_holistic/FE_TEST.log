  margin: 0 0 4px;
}
.opal-center-v2-provenance strong {
  color: #c9d2e0;
  font-weight: 600;
}
html.opal-native-host .opal-center-v2-top {
  padding-top: calc(18px + var(--opal-safe-top));
}
html.opal-native-host .opal-center-v2-refresh {
  top: calc(14px + var(--opal-safe-top));
}


/* ═══════════════════════════════════════════════════════════
   FOUNDER PHYSICAL CLOSEOUT 2026-09-10
   Safe-top owner · Calls overscroll · Create/NewCall/Search micro
   Do not double-count safe-top. Do not enlarge dock.
   ═══════════════════════════════════════════════════════════ */

/* Global subtle status-region protection — not a header box */
html.opal-native-host .app[data-member-nav=\"true\"]::before {
  content: \"\";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: calc(var(--opal-safe-top) + 10px);
  z-index: 55;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(5, 8, 22, 0.94) 0%,
    rgba(5, 8, 22, 0.55) 55%,
    rgba(5, 8, 22, 0) 100%
  );
}

/* Calls: prevent rubber-band reveal behind dock */
html.opal-native-host .chats-home.calls-continuity-home,
html.opal-native-host [data-testid=\"calls-continuity-home\"] {
  overscroll-behavior-y: none !important;
