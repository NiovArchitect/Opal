/* Conversation shell — ONE layout system: absolute (Figma), not grid+absolute mix.
   Header / thread / composer / dock are absolute. Thread is the only scroll owner.
   Journey CTA lives inside .thread as the first scroll child (no overlay). */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] {
  display: block !important;
  position: relative !important;
  height: 100dvh !important;
  max-height: 100dvh !important;
  min-height: 0 !important;
  overflow: hidden !important;
  /* No CSS grid — absolute children own geometry. */
  grid-template-columns: none !important;
  grid-template-rows: none !important;
  grid-template-areas: none !important;
}

/* Sheets / overlays sit above the absolute chrome when open */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > section,
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .call-surface,
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .group-info-dest,
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .graph-create-flow {
  pointer-events: auto;
  z-index: 40;
}

/* Keep absolute header — do not convert to relative/grid */
