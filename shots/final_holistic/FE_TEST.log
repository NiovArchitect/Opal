  top: calc(400px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-auth-v4 .fr-code-wrap {
  top: calc(250px + env(safe-area-inset-top, 0px)) !important;
}
/* Bottom-anchor CTAs for phone/OTP only — profile/find use flow shell. */
html.opal-native-host .fr-auth-v4.fr-phone .fr-primary,
html.opal-native-host .fr-auth-v4.fr-phone .btn.primary.fr-primary,
html.opal-native-host .fr-auth-v4.fr-verify .fr-primary,
html.opal-native-host .fr-auth-v4.fr-verify .btn.primary.fr-primary {
  top: auto !important;
  bottom: calc(66px + env(safe-area-inset-bottom, 0px)) !important;
}
html.opal-native-host .fr-auth-v4.fr-phone .fr-text-action,
html.opal-native-host .fr-auth-v4.fr-phone .fr-skip-for-now,
html.opal-native-host .fr-auth-v4.fr-verify .fr-text-action,
html.opal-native-host .fr-auth-v4.fr-verify .fr-change-number {
  top: auto !important;
  bottom: calc(24px + env(safe-area-inset-bottom, 0px)) !important;
}
html.opal-native-host .fr-auth-v4 .fr-secondary[data-testid=\"fr07-resend\"] {
  top: auto !important;
  bottom: calc(132px + env(safe-area-inset-bottom, 0px)) !important;
}

/* Splash 618:19 — bottom CTAs clear home indicator; hero stack clears status bar */
html.opal-native-host .fr-splash-aura {
  top: calc(108px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-mark {
  top: calc(128px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-wordmark {
  top: calc(338px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-mechanic,
html.opal-native-host .fr-splash-tagline {
  top: calc(408px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-splash-skip {
  top: calc(64px + env(safe-area-inset-top, 0px)) !important;
  bottom: auto !important;
  right: 24px !important;
  left: auto !important;
}
html.opal-native-host .fr-splash-tap {
  top: auto !important;
  bottom: calc(100px + env(safe-area-inset-bottom, 0px)) !important;
}
html.opal-native-host .fr-splash-returning {
  top: auto !important;
  bottom: calc(40px + env(safe-area-inset-bottom, 0px)) !important;
}

/* Promise — native host: clip art so Enter Opal + Sign in stay fully visible. */
html.opal-native-host .first-run-promise-page {
  height: 100dvh !important;
  min-height: 100dvh !important;
  max-height: 100dvh !important;
  padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px)) !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
}
html.opal-native-host .first-run-promise-clip {
  max-height: calc(100dvh - 140px) !important;
  width: min(390px, 100%, calc((100dvh - 140px) * 941 / 1490)) !important;
  flex: 0 1 auto !important;
}
html.opal-native-host .first-run-promise-img {
  width: 100% !important;
  margin: 0 !important;
  height: auto !important;
}
html.opal-native-host .first-run-promise-status-crop {
  height: 40px !important;
}
html.opal-native-host .first-run-promise-cta {
  position: relative !important;
  top: auto !important;
  bottom: auto !important;
  left: auto !important;
  margin: 12px auto calc(8px + env(safe-area-inset-bottom, 0px)) !important;
  flex-shrink: 0 !important;
}

/*
 * Fluid phone first-run / auth (browser + native).
 * Extends native-host bottom-anchor + safe-area to all phone widths ≤519.
 * Do not pad the stage with safe-area AND bottom-anchor CTAs (double-count = 0).
 */
@media (max-width: 519px) {
  .fr-auth-header {
    top: calc(18px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-title {
    top: calc(112px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-body {
    top: calc(194px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4.fr-verify .fr-body,
  .fr-auth-v4.fr-profile .fr-body,
  .fr-auth-v4.fr-find .fr-body {
    top: calc(164px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-status,
  .fr-auth-v4 .fr-error {
    top: calc(230px + env(safe-area-inset-top, 0px));
  }
