            </div>
          ) : null}

          {step === \"fr10\" ? (
            <ActOnBehalfOptInStep
              session={session}
              busy={busy}
              onContinue={() => finishToHome()}
              onSkip={() => finishToHome()}
            />
          ) : null}
        </motion.div>
      </AnimatePresence>
    </div>
  );
}
