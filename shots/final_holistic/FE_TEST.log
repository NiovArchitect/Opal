}
.next-plan-strip {
  position: sticky;
  top: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
  width: calc(100% - 24px);
  margin: 0 12px 8px;
  padding: 7px 10px 7px 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: rgba(8, 16, 28, 0.94);
  color: #f4f7fa;
  text-align: left;
  cursor: pointer;
  pointer-events: auto;
  box-shadow: inset 2px 0 0 transparent;
}
.next-plan-strip[data-plan-state=\"ready\"] {
  border-color: color-mix(in srgb, var(--signal-confirmed) 40%, transparent);
  box-shadow: inset 2px 0 0 var(--signal-confirmed);
}
.next-plan-strip[data-plan-state=\"action\"] {
  border-color: color-mix(in srgb, var(--signal-needs-attention) 40%, transparent);
  box-shadow: inset 2px 0 0 var(--signal-needs-attention);
}
.next-plan-strip[data-plan-state=\"forming\"] {
  border-color: color-mix(in srgb, var(--signal-provisional) 40%, transparent);
  box-shadow: inset 2px 0 0 var(--signal-provisional);
}
.next-plan-strip[data-plan-state=\"past\"] {
  border-color: rgba(244, 247, 250, 0.22);
  box-shadow: inset 2px 0 0 rgba(244, 247, 250, 0.55);
}
.next-plan-strip[data-plan-state=\"ready\"] .next-plan-kicker { color: var(--signal-confirmed); }
.next-plan-strip[data-plan-state=\"action\"] .next-plan-kicker { color: var(--signal-needs-attention); }
.next-plan-strip[data-plan-state=\"forming\"] .next-plan-kicker { color: var(--signal-provisional); }
.next-plan-strip[data-plan-state=\"past\"] .next-plan-kicker { color: #94A1B8; }
.next-plan-kicker {
  font-size: 10px;
  letter-spacing: 0.08em;
  color: #8a96a8;
}
.next-plan-summary {
  font-size: 13px;
  font-weight: 600;
}
.plan-set-event {
  margin: 8px 28px;
  text-align: center;
}
.plan-set-event p {
  margin: 0;
  font-size: 12px;
  color: #8a96a8;
}
.alignment-card.is-sheet {
  position: sticky;
  bottom: 0;
  z-index: 3;
  max-height: 42vh;
  overflow: auto;
}
/* Proposal card scrolls under Next Together — do not sticky-collide with the strip. */
.alignment-card.is-proposal {
  position: relative;
  top: auto;
  z-index: 1;
  scroll-margin-top: 64px;
}
.alignment-card {
  margin: 12px 16px 20px;
  padding: 12px 14px;
  border-radius: 16px;
  border: 1px solid rgba(0, 229, 255, 0.22);
  background: rgba(11, 18, 38, 0.94);
  display: flex;
  flex-direction: column;
  gap: 8px;
  outline: none;
}
.alignment-card[data-attention-focused=\"true\"] {
  border-color: color-mix(in srgb, var(--signal-needs-attention, #ff6b9d) 55%, transparent);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--signal-needs-attention, #ff6b9d) 35%, transparent);
}
/* Keep accessible focus on the actual Accept/Keep controls — not a giant oval on the card. */
.alignment-card:focus,
.alignment-card:focus-visible {
  outline: none;
}
.alignment-choice:focus-visible,
button.alignment-choice:focus-visible,
[data-testid=\"alignment-change-accept\"]:focus-visible,
[data-testid=\"alignment-change-keep\"]:focus-visible {
  outline: 2px solid var(--accent-soft, rgba(110, 231, 245, 0.75));
  outline-offset: 2px;
  border-radius: 999px;
}
.next-plan-strip:focus-visible {
  outline: 2px solid var(--accent-soft, rgba(110, 231, 245, 0.65));
  outline-offset: 2px;
}
.next-plan-strip {
  scroll-margin-top: 0;
}
.alignment-completion,
