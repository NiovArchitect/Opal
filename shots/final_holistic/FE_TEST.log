   * Return true to pause here (do not advance to profile yet).
   */
  onAfterPhoneVerify?: (session: ProductSession) => boolean;
  /** Resume into a specific step after Meet Opal (usually fr08 profile). */
  resumeStep?: FirstRunStepId | null;
