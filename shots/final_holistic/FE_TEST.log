  position: absolute !important;
  left: 16px !important;
  right: 16px !important;
  top: 138px !important;
  width: auto !important;
  max-width: none !important;
  height: auto !important;
  margin: 0 !important;
  pointer-events: auto;
  z-index: 2;
}

/* Keep absolute thread between header and composer+dock */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .thread {
  position: absolute !important;
  top: 148px !important;
  right: 0 !important;
  bottom: 160px !important;
  left: 0 !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
