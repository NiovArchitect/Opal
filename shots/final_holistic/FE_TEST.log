  /** Splash | Promise | Auth  -  both Splash and Promise are TOP-LEVEL (P0-05.9 / Promise lesson). */
  const [firstRunStage, setFirstRunStage] = useState<FirstRunStage>(() => {
    let sessionReset = false;
