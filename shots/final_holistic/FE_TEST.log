  align-items: center;
  justify-content: center;
  gap: 0;
}

.opening-brand-raster,
.opening-brand-lockup {
  width: min(220px, 58vw);
  height: min(220px, 58vw);
  object-fit: contain;
  border-radius: 0;
  /* No permanent logo halo  -  restrained material only */
  filter: none;
  box-shadow: none;
  /* Lockup already sits on void  -  no card plate */
  background: transparent;
}

.opening-brand-mark {
  background: transparent;
}

.opal-lockup--raster {
  display: flex;
  align-items: center;
  justify-content: center;
}

.opal-lockup-raster {
  object-fit: contain;
  display: block;
}

.opal-wordmark-raster {
  object-fit: contain;
  display: block;
  height: auto;
  max-width: 100%;
}

.scene-welcome .scene-brand-arrival {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Responsive: Figma 390 reference; nearby phone widths */
@media (max-width: 430px) {
  .home-editorial {
    font-size: clamp(30px, 8.5vw, 34px);
  }
  .home-awaken-card,
  .presence-section {
    width: auto;
  }
}

.extend-selected {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

/* Shared Reality Figma 4:2 */
.opal-resolution.shared-reality-plate {
