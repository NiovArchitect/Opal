 * Do not pad the stage with safe-area AND bottom-anchor CTAs (double-count = 0).
 */
@media (max-width: 519px) {
  .fr-auth-header {
    top: calc(18px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-title {
    top: calc(112px + env(safe-area-inset-top, 0px));
  }
  .fr-auth-v4 .fr-body {
