  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  height: 148px !important;
  min-height: 148px !important;
  max-height: 148px !important;
  z-index: 30 !important;
  background: transparent;
}

/* Group shared-graph plate: absolute under identity inside taller group header */
