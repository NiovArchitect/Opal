  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
  z-index: 10 !important;
  /* Top pad clears header; bottom pad clears composer so last bubble isn't trapped */
  padding: 12px 14px 28px !important;
