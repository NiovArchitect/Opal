  bottom: 160px !important;
  left: 0 !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
  z-index: 10 !important;
  /* Top pad clears header; bottom pad clears composer so last bubble isn't trapped */
  padding: 12px 14px 28px !important;
  box-sizing: border-box;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  align-items: stretch;
  gap: 10px;
}
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"][data-chat-kind=\"group\"] > .thread {
  top: 220px !important;
}
/* Drop the flex-end spacer hammer — absolute thread owns height; content starts at top */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .thread::before {
  content: none !important;
  display: none !important;
  flex: none !important;
}

/* CTA scrolls with messages — first child of .thread */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .thread > .journey-cta-row {
  position: relative !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  flex: 0 0 auto;
  width: 100%;
  box-sizing: border-box;
  padding: 4px 0 10px;
  margin: 0;
  background: transparent;
  z-index: 1;
  pointer-events: auto;
}
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .thread > .journey-cta-row:empty {
  display: none;
}

/* Composer bottom-anchored above dock — reinforce absolute (no relative/grid hammer) */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .composer-618 {
  position: absolute !important;
  top: auto !important;
  left: 20px !important;
  right: 20px !important;
  bottom: 90px !important;
  width: auto !important;
  max-width: none !important;
  height: 58px !important;
  min-height: 58px !important;
  margin: 0 !important;
  z-index: 40 !important;
  padding: 0 48px 0 48px !important;
}

/* Dock stays absolute at bottom */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] > .tabbar.tabbar-option-b {
  position: absolute !important;
  top: auto !important;
  right: 10px !important;
  bottom: 0 !important;
  left: 10px !important;
  transform: none !important;
  width: auto !important;
  max-width: none !important;
  height: 74px !important;
  min-height: 74px !important;
  max-height: 74px !important;
  margin: 0 !important;
  z-index: 70 !important;
}

.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .alignment-card {
  position: relative !important;
  z-index: 1;
}

/* Attach / voice / send: composer-relative, right-anchored for fluid width */
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-attach,
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-voice,
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-618 .send-btn {
  top: 50% !important;
  bottom: auto !important;
  transform: translateY(-50%);
}
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-attach {
  left: 8px !important;
  right: auto !important;
}
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-voice {
  left: auto !important;
  right: 44px !important;
}
.app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] .composer-618 .send-btn {
  left: auto !important;
  right: 10px !important;
  width: 28px !important;
  height: 28px !important;
  min-width: 28px !important;
}

/* Phone widths: small visible viewport so browser chrome cannot cover dock */
@media (max-width: 519px) {
  html:has([data-conversation-layout=\"structured\"]),
  html:has([data-conversation-layout=\"structured\"]) body {
    height: 100svh;
    max-height: 100svh;
    overflow: hidden;
  }
  .app[data-testid=\"member-conversation\"][data-conversation-layout=\"structured\"] {
    height: 100svh !important;
    max-height: 100svh !important;
    min-height: 0 !important;
    margin-block: 0 !important;
  }
}

.app[data-conversation-layout=\"structured\"] .opal-gap-chip-wrap,
.app[data-conversation-layout=\"structured\"] .opal-context-chip-wrap,
.app[data-conversation-layout=\"structured\"] .opal-private-guidance,
.app[data-conversation-layout=\"structured\"] .next-together-strip {
