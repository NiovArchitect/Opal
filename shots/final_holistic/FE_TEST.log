/* ═══════════════════════════════════════════════════════════
   Mobile product shell — authenticated destinations (A8 HOLD)
   FIXED_844_STAGE_AS_APP_SHELL = 0 for primary member surfaces.
   Phone physical viewport is the app; 844 remains a test reference only.
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 519px) {
  .app[data-member-nav=\"true\"] .gsh.scroll,
  .gsh.scroll {
    width: 100% !important;
    max-width: none !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    min-height: 0 !important;
  }

  .gsh,
  .gsh-top,
  .gsh-top-spectral,
  .graphs-home,
  .chats-home,
  .opal-ambient {
    width: 100% !important;
    max-width: none !important;
  }

  .gsh-top,
  .gsh-top-spectral {
    width: 100% !important;
    max-width: none !important;
    padding-top: env(safe-area-inset-top, 0px);
  }

  .profile-person-overlay,
  .gprof,
  .gprof-mem-grid,
  .opal-ambient-destination,
  .opal-ambient-overlay,
  .graph-create-flow,
  .graph-create-choose,
  .graph-create-compose,
  .full-live-863,
  .profile-pane.you-pane-nested,
  .you-pane-nested,
  .group-info-dest,
  .call-continuity-dest,
  .new-call-dest,
  .search-dest-373-261,
  .activity-dest-473-141,
  .ogsn-graph-detail.social-dest-373-385 {
    width: 100% !important;
    max-width: none !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    min-height: 0 !important;
  }

  /* Full-bleed overlays still clear home indicator when scrolled */
  .activity-dest-473-141,
  .ogsn-graph-detail.social-dest-373-385,
  .search-dest-373-261 {
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
}


/* COHERENCE: graph status pill must stay in viewport */
.graphs-card-top {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.graphs-card-title {
  min-width: 0;
  overflow: hidden;
