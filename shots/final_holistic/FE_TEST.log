  .fr-splash-wordmark {
    top: calc(338px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mechanic,
  .fr-splash-tagline {
    top: calc(408px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-skip {
    top: calc(64px + env(safe-area-inset-top, 0px));
    bottom: auto;
    right: 24px;
    left: auto;
  }
  .fr-splash-tap {
    top: auto;
    bottom: calc(100px + env(safe-area-inset-bottom, 0px));
  }
  .fr-splash-returning {
    top: auto;
    bottom: calc(40px + env(safe-area-inset-bottom, 0px));
  }

  .first-run-promise-page {
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
