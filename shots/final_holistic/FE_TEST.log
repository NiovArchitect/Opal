  }
  .first-run-promise-img {
    width: 100%;
    margin: 0;
    height: auto;
  }
  .first-run-promise-status-crop {
    height: 40px;
  }
  .first-run-promise-cta {
    position: relative;
    top: auto;
    bottom: auto;
