    gap: 10px;
    box-sizing: border-box;
  }
  .fr-auth-v4.fr-find .fr-find-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px auto 0;
  }

  .fr-splash-aura {
    top: calc(108px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mark {
    top: calc(128px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-wordmark {
    top: calc(338px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-mechanic,
  .fr-splash-tagline {
    top: calc(408px + env(safe-area-inset-top, 0px));
  }
  .fr-splash-skip {
    top: calc(64px + env(safe-area-inset-top, 0px));
    bottom: auto;
    right: 24px;
    left: auto;
  }
  .fr-splash-tap {
    top: auto;
    bottom: calc(100px + env(safe-area-inset-bottom, 0px));
  }
  .fr-splash-returning {
    top: auto;
    bottom: calc(40px + env(safe-area-inset-bottom, 0px));
  }

  .first-run-promise-page {
