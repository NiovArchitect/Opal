html:has(.app-first-run-splash),
html:has(.app-first-run-promise),
html:has(.app-first-run-meet-opal),
html:has(.app-premember .first-run),
html:has(.app-first-run-splash) body,
html:has(.app-first-run-promise) body,
html:has(.app-first-run-meet-opal) body,
html:has(.app-premember .first-run) body,
html:has(.app-first-run-splash) #root,
html:has(.app-first-run-promise) #root,
html:has(.app-first-run-meet-opal) #root,
html:has(.app-premember .first-run) #root {
  height: 100dvh;
  max-height: 100dvh;
  overflow: hidden;
}
.app.app-first-run-splash,
.app.app-first-run-promise,
.app.app-first-run-meet-opal,
.app.app-premember:has(.first-run) {
  height: 100dvh;
  min-height: 0;
  max-height: 100dvh;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
  overscroll-behavior-y: contain;
}
.app.app-first-run-splash > .fr-splash,
.app.app-first-run-promise > .first-run-promise-page,
.app.app-first-run-meet-opal > .hs-meet-opal,
.app.app-premember:has(.first-run) .first-run-standalone,
.app.app-premember:has(.first-run) .fr-auth-v4 {
  flex-shrink: 0;
}
/* Desktop keeps the existing 12px inset. Phone widths stay on the 100dvh scrollport. */
@media (min-width: 520px) {
  html:has(.app-first-run-splash),
  html:has(.app-first-run-promise),
  html:has(.app-first-run-meet-opal),
  html:has(.app-premember .first-run),
  html:has(.app-first-run-splash) body,
  html:has(.app-first-run-promise) body,
  html:has(.app-first-run-meet-opal) body,
  html:has(.app-premember .first-run) body,
  html:has(.app-first-run-splash) #root,
  html:has(.app-first-run-promise) #root,
  html:has(.app-first-run-meet-opal) #root,
  html:has(.app-premember .first-run) #root {
    max-height: none;
    overflow: visible;
  }
  .app.app-first-run-splash,
  .app.app-first-run-promise,
  .app.app-first-run-meet-opal,
  .app.app-premember:has(.first-run) {
    height: calc(100dvh - 24px);
    max-height: calc(100dvh - 24px);
  }
}

/*
 * POST-R1B native shell law (Figma 1075:2):
 * On Expo WKWebView the Opal field IS the app surface.
 * max-width:390 + margin:auto letterboxes on real phones → \"Opal inside another app\".
 * Formal Figma measurement remains 390; native host fills the device.
 */
html.opal-native-host,
html.opal-native-host body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: var(--bg, #050816);
  overscroll-behavior: none;
}
html.opal-native-host #root {
  width: 100%;
  min-height: 100%;
  min-height: 100dvh;
}
html.opal-native-host .app,
html.opal-native-host .app-premember,
html.opal-native-host .app-first-run-splash {
  max-width: none !important;
  width: 100% !important;
  margin: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  min-height: 100dvh !important;
  height: 100% !important;
}
html.opal-native-host .fr-splash,
html.opal-native-host .fr-auth-v4 {
  max-width: none !important;
  width: 100% !important;
  min-height: 100dvh !important;
  height: 100dvh !important;
}
@media (min-width: 520px) {
  html.opal-native-host .app {
    border-radius: 0 !important;
    margin-block: 0 !important;
    min-height: 100dvh !important;
    height: 100% !important;
    box-shadow: none !important;
  }
  html.opal-native-host body {
    background: var(--bg, #050816) !important;
  }
}

/*
 * P0 physical safe-area (Figma 1075:2 law):
 * Background may be edge-to-edge. CONTENT must clear status bar + home indicator.
 * SAFE_AREA_OWNER = WEB (native WebView does not inset; env() applies in WKWebView).
 * Do not re-card the app; do not invent per-device pixel offsets.
 */
html.opal-native-host {
  /* Match auth/splash field so inset margins read as continuous Opal void */
  background: #050816;
}
html.opal-native-host .fr-auth-header {
  top: calc(18px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-auth-v4 .fr-title {
  top: calc(112px + env(safe-area-inset-top, 0px)) !important;
}
html.opal-native-host .fr-auth-v4 .fr-body {
