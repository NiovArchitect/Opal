  border: 1px solid rgba(61, 222, 153, 0.35);
  box-shadow: 0 16px 32px -6px rgba(0, 0, 0, 0.45);
}

.sr-kicker {
  margin: 0 0 10px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1.2px;
  color: #3dde99;
  text-transform: uppercase;
}

.sr-title {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--text);
}

