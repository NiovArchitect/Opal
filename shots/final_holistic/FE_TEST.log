  const [hourText, minute] = time.split(\":\");
  const hour = Number(hourText);
  const suffix = hour >= 12 ? \"PM\" : \"AM\";
  const hour12 = hour % 12 || 12;
  return `${weekdays[utc.getUTCDay()]} · ${months[month - 1]} ${day} · ${hour12}:${minute} ${suffix}`;
}
