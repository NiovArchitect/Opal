    setCallLogStatus((prev) => (prev === \"ready\" ? prev : \"loading\"));
    void listCalls(current.access_token)
      .then((res) => {
        setCallLog(Array.isArray(res.calls) ? res.calls : []);
        setCallLogStatus(\"ready\");
      })
      .catch(() => {
        setCallLogStatus(\"error\");
