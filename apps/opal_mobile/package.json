{
  "name": "opal-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "lint": "tsc --noEmit",
    "postinstall": "bash scripts/ensure-expo-asset-link.sh && patch-package",
    "start:dev-client": "bash scripts/ensure-expo-asset-link.sh && expo start --dev-client --lan"
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-contacts": "~14.2.0",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-notifications": "~0.31.4",
    "expo-secure-store": "~14.2.0",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^57.1.0",
    "expo-sqlite": "~15.2.0",
    "expo-status-bar": "~2.2.0",
    "phoenix": "^1.7.21",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-webview": "^13.13.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/phoenix": "^1.6.6",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.3.0",
    "typescript": "~5.8.3"
  }
}
