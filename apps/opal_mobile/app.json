{
  "expo": {
    "name": "Opal Graph",
    "slug": "opal-mobile",
    "version": "0.13.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.opal.mobile",
      "infoPlist": {
        "NSContactsUsageDescription": "Choose people you already know so you can invite them on Opal. Opal only invites the people you select.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      },
      "package": "local.opal.mobile",
      "permissions": [
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose people you already know so you can invite them on Opal. Opal only invites the people you select."
        }
      ],
      "./plugins/withReadOnlyContacts.js",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "buildNumber": "12",
      "releaseNote": "Internal RC profile support — synthetic providers only",
      "eas": {
        "projectId": "de17c8b3-074e-4656-980d-e16fc10bbda4"
      }
    },
    "owner": "sadeil"
  }
}
