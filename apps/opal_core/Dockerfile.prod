# Production image for hosted Opal API (Social Flow 16)
# Build context: monorepo root
FROM elixir:1.17-otp-27-alpine AS build

RUN apk add --no-cache build-base git
WORKDIR /app

ENV MIX_ENV=prod
ENV LANG=C.UTF-8

RUN mix local.hex --force && mix local.rebar --force

COPY apps/opal_core/mix.exs apps/opal_core/mix.lock /app/apps/opal_core/
WORKDIR /app/apps/opal_core
RUN mix deps.get --only prod && mix deps.compile

COPY packages/contracts /app/packages/contracts
COPY apps/opal_core /app/apps/opal_core

RUN mix compile
RUN mix release opal_core

FROM alpine:3.20 AS app
RUN apk add --no-cache openssl ncurses-libs libstdc++ libgcc curl
WORKDIR /app
ENV MIX_ENV=prod
ENV LANG=C.UTF-8
ENV PHX_SERVER=true
ENV HOME=/app

COPY --from=build /app/apps/opal_core/_build/prod/rel/opal_core ./
COPY apps/opal_core/docker-entrypoint.prod.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 4000
ENTRYPOINT ["/docker-entrypoint.sh"]
