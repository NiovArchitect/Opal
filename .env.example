# Local development only — never commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opal_core_dev
DATABASE_URL=ecto://postgres:postgres@localhost/opal_core_dev

OPAL_AI_URL=http://127.0.0.1:8000
PORT=4000
SECRET_KEY_BASE=generate-a-long-random-string-for-local-dev-only

# Center / intelligence LLM (Repair #18) - names and purpose only, never
# commit a real value. When OPAL_LLM_API_KEY is absent the Center falls
# back to templates and logs llm_unavailable_using_templates per turn.
OPAL_LLM_PROVIDER=deepseek
OPAL_LLM_API_KEY=
OPAL_LLM_MODEL=
