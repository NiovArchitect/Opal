{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opal.local/schemas/ai_job_response.schema.json",
  "title": "AiJobResponse",
  "description": "Structured AI job result from Python to Elixir. Never carries authorization or consent grants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "capability",
    "status",
    "output",
    "model_metadata",
    "safety",
    "completed_at",
    "trace_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "enum": [
        "ai_echo",
        "safe_drafting",
        "transcription",
        "translation",
        "commitment_candidate_extraction",
        "social_flow_plan_extract",
        "social_flow_follow_through_extract",
        "social_flow_memory_candidate_extract",
        "social_flow_relevance_rank"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "refused", "failed"]
    },
    "output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "normalized_text": {
          "type": "string",
          "maxLength": 8000
        },
        "character_count": {
          "type": "integer",
          "minimum": 0
        },
        "context_item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "result_type": {
          "type": "string",
          "enum": [
            "plan_candidate",
            "no_plan",
            "commitment_candidate",
            "revision_candidate",
            "memory_candidate",
            "no_memory",
            "relevance_ranking"
          ]
        },
        "rankings": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "ordinal", "recommend_surface"],
            "properties": {
              "candidate_id": {"type": "string", "maxLength": 128},
              "ordinal": {"type": "integer", "minimum": 1, "maximum": 20},
              "internal_score": {"type": "number", "minimum": 0, "maximum": 1},
              "recommend_surface": {
                "type": "string",
                "enum": ["needs_you", "inline", "suppress", "shadow_only"]
              },
              "copy_key": {"type": "string", "maxLength": 64},
              "rationale": {"type": "string", "maxLength": 256},
              "uncertainty": {
                "type": "array",
                "maxItems": 5,
                "items": {"type": "string", "maxLength": 128}
              },
              "suppress": {"type": "boolean"}
            }
          }
        },
        "memory_candidate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "candidate_type": {
              "type": "string",
              "enum": ["gift_preference", "important_date", "personal_note", "other"]
            },
            "summary": {"type": "string", "maxLength": 512},
            "proposed_purpose": {"type": "string", "maxLength": 256},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "suggested_review_hint": {"type": ["string", "null"], "maxLength": 64},
            "uncertainty": {
              "type": "array",
              "maxItems": 10,
              "items": {"type": "string", "maxLength": 256}
            }
          }
        },
        "candidate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "activity": {"type": ["string", "null"], "maxLength": 256},
            "participant_mentions": {
              "type": "array",
              "maxItems": 10,
              "items": {"type": "string", "maxLength": 128}
            },
            "temporal_expressions": {
              "type": "array",
              "maxItems": 10,
              "items": {"type": "string", "maxLength": 128}
            },
            "normalized_time_candidates": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "confidence"],
                "properties": {
                  "label": {"type": "string", "maxLength": 128},
                  "iso_hint": {"type": ["string", "null"], "maxLength": 64},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            },
            "location_expression": {"type": ["string", "null"], "maxLength": 256},
            "possible_commitments": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "confidence"],
                "properties": {
                  "description": {"type": "string", "maxLength": 512},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            },
            "revision_hint": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "change_type": {"type": "string", "enum": ["time_change", "other"]},
                "proposed_label": {"type": "string", "maxLength": 128},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "missing_information": {
              "type": "array",
              "maxItems": 10,
              "items": {"type": "string", "maxLength": 128}
            },
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "recommended_signal_copy": {"type": ["string", "null"], "maxLength": 512}
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "field"],
            "properties": {
              "source_id": {"type": "string", "maxLength": 128},
              "field": {"type": "string", "maxLength": 64},
              "snippet": {"type": "string", "maxLength": 256}
            }
          }
        },
        "uncertainty": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 256}
        },
        "context_note": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "model_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "model_version"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["local"]
        },
        "model": {
          "type": "string",
          "enum": [
            "deterministic-echo",
            "deterministic-plan-extract",
            "deterministic-relevance",
            "deterministic-memory-extract"
          ]
        },
        "model_version": {
          "type": "string",
          "const": "0.1.0"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasons"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allowed", "refused"]
        },
        "reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}
