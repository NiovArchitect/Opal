{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opal.local/schemas/error_envelope.schema.json",
  "title": "ErrorEnvelope",
  "description": "Stable error envelope for API and job boundary failures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error_code",
    "message",
    "retryable",
    "trace_id",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Machine-stable code, e.g. consent_denied, schema_invalid."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
